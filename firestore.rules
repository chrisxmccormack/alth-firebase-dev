rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // IMPORTANT: Replace with your actual Admin UID
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }
    
    // Checks the flag on the user's own document. This breaks the circular dependency.
    function isApprovedUser() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyIsApproved == true;
    }
    
    function usersCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    // RULES
    match /users/{userId} {
      // You can read your own user document. Admin can read any.
      allow read: if request.auth.uid == userId || isSystemAdmin();
      // A user can create their own document on signup.
      allow create: if request.auth.uid == userId;
      // You can update your companyId (one time). Admin can approve you.
      allow update: if (request.auth.uid == userId && request.resource.data.companyId != resource.data.companyId) || isSystemAdmin();
    }

    match /companies/{companyId} {
      // Anyone can read an approved company. You can always read your own.
      allow read: if resource.data.status == 'Approved' || (isSignedIn() && usersCompanyId() == companyId);

      // You can create a company if you don't already have one.
      allow create: if isSignedIn() && usersCompanyId() == null && request.resource.data.ownerUid == request.auth.uid;
      
      // Only the admin can approve a company.
      allow update: if isSystemAdmin();
    }

    match /contacts/{contactId} {
      // You can read a contact if your company is a member.
      allow read: if isSignedIn() && usersCompanyId() in resource.data.members;

      // CREATE: An approved user can create a valid Pending or Unverified contact.
      allow create: if 
        isApprovedUser() &&
        request.resource.data.companyAId == usersCompanyId() &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.members[0] == usersCompanyId() &&
        request.resource.data.companyBId == null &&
        (
          ( // Scenario 1: 'Unverified' direct create
            request.resource.data.status == 'Unverified' &&
            request.resource.data.partnerCompanyDetails is map &&
            request.resource.data.contactPerson is map
          ) ||
          ( // Scenario 2: 'Pending' invite
            request.resource.data.status == 'Pending' &&
            request.resource.data.inviteToken is string &&
            request.resource.data.expiresAt is timestamp
          )
        );

      // UPDATE: To accept an invite, you must be an approved user and the target (companyB).
      allow update: if 
        isApprovedUser() &&
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Connected' &&
        request.resource.data.companyBId == usersCompanyId() &&
        request.resource.data.members.size() == 2 &&
        request.resource.data.members[1] == usersCompanyId();

      allow delete: if false; // No client deletes.
    }
  }
}
