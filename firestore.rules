rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // IMPORTANT: Replace with your actual Admin UID from .env.local
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE'; 
    }
    
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function requestingUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function requestingUserCompanyId() {
      return requestingUserDoc().data.companyId;
    }

    function isRegisteredUser() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             requestingUserDoc().data.companyId != null;
    }
    
    function isApprovedUser() {
      let companyId = requestingUserCompanyId();
      return isRegisteredUser() &&
             exists(/databases/$(database)/documents/companies/$(companyId)) &&
             get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'Approved';
    }


    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      allow read: if isRegisteredUser();

      // Allow create if user is signing up (owner matches) OR if an approved user is creating an ownerless contact.
      allow create: if isSignedIn() && 
                    ( (request.resource.data.ownerUid == request.auth.uid) ||
                      (isApprovedUser() && request.resource.data.ownerUid == null) );

      // Only the System Admin can approve/update companies.
      allow update: if isSystemAdmin();
    }
    
    match /contacts/{contactId} {
      // Allow read/update if the user is a member of the contact.
      allow read, update: if isRegisteredUser() && requestingUserCompanyId() in resource.data.members;

      // Allow creating a contact if the user is approved and the new contact data is valid.
      // This rule does NOT check for the existence of companyBId, as it is created in the same transaction.
      allow create: if isApprovedUser() &&
                     request.resource.data.companyAId == requestingUserCompanyId() &&
                     request.resource.data.companyBId != null &&
                     requestingUserCompanyId() in request.resource.data.members &&
                     request.resource.data.companyBId in request.resource.data.members;
    }

    match /orders/{orderId} {
      // Allow read/update if the user is a member of the order.
      allow read, update: if isRegisteredUser() && requestingUserCompanyId() in resource.data.members;

      // Allow creating an order if user is an approved seller and the data is valid.
      allow create: if isApprovedUser() &&
                     request.resource.data.sellerCompanyId == requestingUserCompanyId() &&
                     requestingUserCompanyId() in request.resource.data.members &&
                     request.resource.data.buyerCompanyId in request.resource.data.members;
    }
  }
}
