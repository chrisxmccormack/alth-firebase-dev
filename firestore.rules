rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // CRITICAL: Replace 'YOUR_ADMIN_UID_HERE' with your actual System Admin UID
      return isSignedIn() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedUser() {
      let userData = getUserData();
      if (userData.companyId == null) {
        return false;
      }
      return get(/databases/$(database)/documents/companies/$(userData.companyId)).data.status == 'Approved';
    }


    // --- Collection Rules ---

    match /users/{userId} {
      allow read, create: if isOwner(userId);
      // User can only update their own companyId
      allow update: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['companyId']);
    }

    match /companies/{companyId} {
      // Any signed-in user can read company info, which is considered public.
      // This also prevents a circular dependency in permission checks.
      allow read: if isSignedIn();

      allow create:
        // Scenario 1: Initial company setup by its owner.
        (isOwner(request.resource.data.ownerUid) && request.resource.data.status == 'Pending')
        ||
        // Scenario 2: An approved user creates a company for a contact (no owner).
        (isApprovedUser() && request.resource.data.ownerUid == null);

      allow update:
        // Scenario 1: Admin approves a company.
        (isAdmin() && request.resource.data.status == 'Approved' && resource.data.status == 'Pending')
        ||
        // Scenario 2: Company owner updates their own details (but cannot change status or owner).
        (isApprovedUser() && isOwner(resource.data.ownerUid)
          && request.resource.data.status == resource.data.status
          && request.resource.data.ownerUid == resource.data.ownerUid);
    }

    match /contacts/{contactId} {
      allow read: if isApprovedUser() && getUserData().companyId in resource.data.members;

      allow create:
        // Scenario 1: Invite link flow (creating a 'Pending' contact).
        (isApprovedUser()
          && request.resource.data.status == 'Pending'
          && request.resource.data.companyAId == getUserData().companyId
          && request.resource.data.companyBId == null)
        ||
        // Scenario 2: Direct create flow (creating a 'Connected' contact).
        (isApprovedUser()
          && request.resource.data.status == 'Connected'
          && request.resource.data.companyAId == getUserData().companyId
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyBId)).data.ownerUid == null);

      allow update:
        // Scenario for accepting an invite.
        isApprovedUser()
        && resource.data.status == 'Pending'
        && request.resource.data.status == 'Connected'
        && request.resource.data.companyBId == getUserData().companyId
        && request.resource.data.companyAId == resource.data.companyAId
        && !('inviteToken' in request.resource.data);
    }

    match /orders/{orderId} {
      allow read, update: if isApprovedUser() && getUserData().companyId in resource.data.members;
      allow create: if isApprovedUser() && request.resource.data.sellerCompanyId == getUserData().companyId;
    }
  }
}
