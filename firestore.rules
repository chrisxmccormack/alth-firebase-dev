
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isUser(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      // IMPORTANT: Replace with your actual Admin User ID from Firebase Auth
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function isApprovedUser() {
      let companyId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
      return companyId != null && get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'Approved';
    }
    
    function isOwner(companyId) {
        return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid;
    }

    // --- Rules for Collections ---

    match /users/{userId} {
      allow read, write: if isUser(userId) || isAdmin();
    }

    match /companies/{companyId} {
      allow read: if isAdmin() || (isApprovedUser() && isOwner(companyId));
      allow create: if isApprovedUser() || (request.resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || isOwner(companyId);
    }

    match /contacts/{contactId} {
      allow read: if isApprovedUser() && request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;
      
      // Handle creating a contact through an invite link (pending) or directly (connected)
      allow create: if isApprovedUser() && 
                      (
                        // Case 1: Creating a pending contact via invite link
                        (request.resource.data.status == 'Pending' && request.resource.data.companyAId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId)
                        ||
                        // Case 2: Creating a connected contact directly.
                        // This involves a batch write creating a new company and a new contact.
                        (
                          request.resource.data.status == 'Connected' &&
                          request.resource.data.companyAId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId &&
                          // Ensure the new company being created in the same batch has no owner
                          getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyBId)).data.ownerUid == null
                        )
                      );

      // Handle a user accepting an invite, which updates the contact
      allow update: if isApprovedUser() && 
                      request.resource.data.status == 'Connected' &&
                      resource.data.status == 'Pending' &&
                      request.resource.data.companyBId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
                      
      allow delete: if false; // Deletions not allowed
    }

    match /orders/{orderId} {
        allow read: if isApprovedUser() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;
        allow create: if isApprovedUser() && request.resource.data.sellerCompanyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
        allow update: if isApprovedUser() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;
        allow delete: if false;
    }
  }
}
