
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // IMPORTANT: Replace with your actual Admin UID string
      return isUser('YOUR_ADMIN_UID_HERE');
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isApprovedUser(userId) {
      let userData = getUserData(userId);
      return isSignedIn() &&
             userData.companyId != null &&
             getCompanyData(userData.companyId).status == 'Approved';
    }

    function isCompanyOwner(companyId, userId) {
      return getCompanyData(companyId).ownerUid == userId;
    }

    function isMemberOfContact(contactData) {
      let userCompanyId = getUserData(request.auth.uid).companyId;
      return userCompanyId in contactData.members;
    }

    function isMemberOfOrder(orderData) {
      let userCompanyId = getUserData(request.auth.uid).companyId;
      return userCompanyId in orderData.members;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read, update, delete: if isUser(userId);
      allow create: if isSignedIn();
    }

    match /companies/{companyId} {
      allow read: if isApprovedUser(request.auth.uid);
      allow create: if (
                      // Case 1: A new user is setting up their own company
                      (isSignedIn() && request.resource.data.ownerUid == request.auth.uid) ||
                      // Case 2: An approved user is manually creating a contact company (which has no owner).
                      // This is part of the batch write that also creates the contact document.
                      (isApprovedUser(request.auth.uid) && request.resource.data.ownerUid == null)
                    );
      allow update: if isAdmin() || isCompanyOwner(companyId, request.auth.uid);
    }

    match /contacts/{contactId} {
      allow read: if isApprovedUser(request.auth.uid) && isMemberOfContact(resource.data);
      allow create: if isApprovedUser(request.auth.uid) && 
                       request.resource.data.companyAId == getUserData(request.auth.uid).companyId;
      allow update: if isApprovedUser(request.auth.uid) && 
                       (isMemberOfContact(resource.data) || // An existing member can update the contact
                       request.resource.data.companyBId == getUserData(request.auth.uid).companyId); // A new member can accept an invite
    }

    match /orders/{orderId} {
        allow read, update: if isApprovedUser(request.auth.uid) && isMemberOfOrder(resource.data);
        allow create: if isApprovedUser(request.auth.uid) && 
                         request.resource.data.sellerCompanyId == getUserData(request.auth.uid).companyId;
    }
  }
}
