rules_version = '2';

// NOTE: Replace 'YOUR_ADMIN_UID_HERE' with your actual admin UID before deploying.
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================

    // Returns the user's data document from the /users collection.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Checks if the requesting user is the system administrator.
    function isSystemAdmin() {
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Checks if the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the user has an approved company associated with their account.
    function userHasApprovedCompany() {
      let userData = getUserData();
      // Ensure the user document and companyId exist.
      if (!('companyId' in userData) || userData.companyId == null) {
        return false;
      }
      // Get the company document.
      let companyData = get(/databases/$(database)/documents/companies/$(userData.companyId)).data;
      // Check if the company status is 'Approved'.
      return companyData.status == 'Approved';
    }
    
    // =================================
    // Collection: users
    // =================================
    match /users/{userId} {
      // Users can read and update their own document. Admin can read any.
      allow read, update: if request.auth.uid == userId || isSystemAdmin();
      // Users are created via a server-side function (registration), not directly.
      // Allow create only if the document ID matches the authenticated user's ID.
      allow create: if request.auth.uid == userId;
    }

    // =================================
    // Collection: companies
    // =================================
    match /companies/{companyId} {
      // Any authenticated user can read company data. This is necessary to
      // see partner company names in contacts and orders.
      allow read: if isAuthenticated();

      // Allow updates only by the company owner or the system admin.
      allow update: if (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid) || isSystemAdmin();
      
      // Allow creation under two specific conditions:
      // 1. A user setting up their own company for the first time.
      // 2. An approved user creating an ownerless company (for a direct contact).
      allow create: if 
          // Condition 1: New user registration flow
          (request.resource.data.ownerUid == request.auth.uid)
          ||
          // Condition 2: Creating a direct contact (ownerless company)
          (request.resource.data.ownerUid == null && userHasApprovedCompany());
    }

    // =================================
    // Collection: contacts
    // =================================
    match /contacts/{contactId} {
      // A user can read a contact if their company is a member. Admin can read any.
      allow read: if getUserData().companyId in resource.data.members || isSystemAdmin();

      // Allow creation if the user has an approved company and is companyA.
      allow create: if userHasApprovedCompany() && request.resource.data.companyAId == getUserData().companyId;
      
      // Allow updates (e.g., accepting an invite) if the user's company is companyB
      // and the status is changing to 'Connected'.
      allow update: if userHasApprovedCompany() 
                      && request.resource.data.companyBId == getUserData().companyId
                      && request.resource.data.status == 'Connected'
                      && resource.data.status == 'Pending';
    }

    // =================================
    // Collection: orders
    // =================================
    match /orders/{orderId} {
      // A user can read an order if their company is a member. Admin can read any.
      allow read: if getUserData().companyId in resource.data.members || isSystemAdmin();
      
      // Allow creation if the user is the seller and has an approved company.
      allow create: if userHasApprovedCompany() && request.resource.data.sellerCompanyId == getUserData().companyId;

      // Allow updates if the user's company is a member.
      // More specific logic for status transitions is handled in server actions,
      // but this provides the basic permission.
      allow update: if userHasApprovedCompany() && getUserData().companyId in resource.data.members;
    }
  }
}
