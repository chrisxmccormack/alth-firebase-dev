
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    
    // It's safe to use get() here because these rules are not used in list queries.
    // They are for direct document access (e.g., /users/{userId}).
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isSystemAdmin() {
      // The admin UID must be set in your deployed environment.
      // In Firebase Studio, it's in .env.local. In a real deployment, it would be a secret.
      // This is a placeholder for local testing and will be replaced by the actual UID on deployment.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // This function can be called in list queries because it only accesses request data.
    function getMyCompanyIdFromRequest() {
      // Accessing request.auth.token is only reliable if you set a custom claim.
      // For this app, we read the user's document to get the companyId.
      // This function assumes the calling rule has already fetched the user doc.
      return getUserData(request.auth.uid).companyId;
    }

    // This function can NOT be used in list queries because it performs a 'get'.
    // Use it only for rules on single-document reads/writes.
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }


    // USER DATA
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isSystemAdmin());
      allow create: if isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
    }

    // COMPANY DATA
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSystemAdmin();
    }
    
    // CONTACTS
    match /contacts/{contactId} {
      allow read: if isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;

      // Allow creating a 'Pending' invite or a direct 'Connected' contact
      allow create: if isSignedIn() && (
        ( // Creating an invite link
          request.resource.data.status == 'Pending' &&
          request.resource.data.companyAId == getUserData(request.auth.uid).companyId &&
          request.resource.data.companyBId == null
        ) ||
        ( // Creating a direct connection
          request.resource.data.status == 'Connected' &&
          request.resource.data.companyAId == getUserData(request.auth.uid).companyId &&
          request.resource.data.companyBId != null
        )
      );

      // Allow accepting an invite
      allow update: if isSignedIn() &&
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Connected' &&
        request.resource.data.companyBId == getUserData(request.auth.uid).companyId &&
        request.resource.data.inviteToken == null;
    }


    // ORDERS
    match /orders/{orderId} {
      allow read: if isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;
      
      allow create: if isSignedIn() && 
                      request.resource.data.sellerCompanyId == getUserData(request.auth.uid).companyId &&
                      request.resource.data.status == 'Draft';

      allow update: if isSignedIn() && 
                      ( (isSeller() && validSellerUpdate()) || (isBuyer() && validBuyerUpdate()) );
                      
      function isSeller() {
        return getUserData(request.auth.uid).companyId == resource.data.sellerCompanyId;
      }
      
      function isBuyer() {
        return getUserData(request.auth.uid).companyId == resource.data.buyerCompanyId;
      }

      function validSellerUpdate() {
        return (
          // Seller agrees to cancel
          (resource.data.status == 'Draft' && request.resource.data.status == 'Cancelled') ||
          (resource.data.status == 'Agreed' && request.resource.data.status == 'Cancelled') ||
          // Seller marks as Paid (manual override) or Dispatched
          (resource.data.status == 'Agreed' && request.resource.data.status == 'Paid') ||
          (resource.data.status == 'Paid' && request.resource.data.status == 'Dispatched')
        ) && (
          // Ensure only status and trackingId can be changed by seller
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'trackingId'])
        );
      }

      function validBuyerUpdate() {
        return (
          // Buyer agrees to draft
          (resource.data.status == 'Draft' && request.resource.data.status == 'Agreed') ||
          // Buyer marks as delivered
          (resource.data.status == 'Dispatched' && request.resource.data.status == 'Delivered') ||
          // Buyer disputes an escrow order within the deadline
          (
            resource.data.status == 'Delivered' && request.resource.data.status == 'Disputed' &&
            resource.data.paymentMethod == 'Escrow' &&
            (!resource.data.keys().hasAll(['escrowDeadline']) || request.time < resource.data.escrowDeadline)
          )
        ) && (
           // Ensure only status and escrow deadline can be changed by buyer
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'escrowDeadline'])
        );
      }
    }
  }
}
