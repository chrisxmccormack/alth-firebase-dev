rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isSystemAdmin() {
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedUser() {
      // Safely reads the user's approval status from their Firestore document.
      let userData = getUserData();
      return userData != null && userData.get('companyIsApproved', false) == true;
    }
    
    // --- USERS ---
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if isSignedIn();
    }
    
    // --- COMPANIES ---
    match /companies/{companyId} {
      allow read: if isSystemAdmin() || isApprovedUser() || 
                    (isSignedIn() && request.auth.uid == resource.data.ownerUid);
      allow create: if isSignedIn();
      allow update: if isSystemAdmin();
    }
    
    // --- CONTACTS ---
    match /contacts/{contactId} {
      // GET: Can get a single doc if you are an approved member.
      allow get: if isApprovedUser() && resource.data.members.hasAny([getUserData().companyId]);
      
      // LIST: Can list contacts if you are an approved user.
      // The client query MUST be constrained with .where('members', 'array-contains', ...)
      allow list: if isApprovedUser();
      
      // CREATE: 
      // 1. Creating an invite link ("Pending") requires approval.
      // 2. Creating a manual contact ("Unverified") requires ownership.
      allow create: if isSignedIn() &&
                      ( (request.resource.data.status == 'Pending' && isApprovedUser()) ||
                        (request.resource.data.status == 'Unverified' && request.resource.data.ownerUid == request.auth.uid) );

      // UPDATE: To accept an invite ("Connected"), you must be an approved user.
      allow update: if isApprovedUser() && request.resource.data.status == 'Connected';
    }
    
    // --- ORDERS ---
    match /orders/{orderId} {
      // GET: Can get a single doc if you are an approved member.
      allow get: if isApprovedUser() && resource.data.members.hasAny([getUserData().companyId]);
      
      // LIST: Can list orders if you are an approved user.
      // The client query MUST be constrained with .where('members', 'array-contains', ...)
      allow list: if isApprovedUser();

      // CREATE: An approved user can create an order if they are a member of it.
      allow create: if isApprovedUser() && request.resource.data.members.hasAny([getUserData().companyId]);

      // UPDATE: An approved member can update an order, but cannot change the members list.
      allow update: if isApprovedUser() && resource.data.members.hasAny([getUserData().companyId])
                      && request.resource.data.members == resource.data.members;
    }
  }
}
