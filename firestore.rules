
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isApprovedUser(userId) {
      let userData = getUserData(userId);
      // Safely access companyIsApproved, default to false if it doesn't exist
      return userData.companyIsApproved == true;
    }
    
    function isUserCompanyMember(userId, companyId) {
       let userData = getUserData(userId);
       return userData.companyId == companyId;
    }
    
    // --- Users Collection ---
    // Users can only read and update their own user document.
    // New user documents are created via a server-side action (register page).
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if false; // Disallow client-side creation
    }
    
    // --- Companies Collection ---
    // Anyone can create a company (as part of setup).
    // Only approved users can read the list of companies.
    // Updates can only be made by the system admin (for approval) or the company owner.
    match /companies/{companyId} {
      allow create: if request.auth != null;
      allow read: if isApprovedUser(request.auth.uid);
      allow update: if request.auth.uid == resource.data.ownerUid || 
                       request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }
    
    // --- Orders Collection ---
    // Orders can only be read or listed by approved users.
    // Detailed read/write access is controlled by checking membership.
    match /orders/{orderId} {
       allow get: if isApprovedUser(request.auth.uid) && 
                      isUserCompanyMember(request.auth.uid, resource.data.buyerCompanyId) ||
                      isUserCompanyMember(request.auth.uid, resource.data.sellerCompanyId);
                      
       allow list: if isApprovedUser(request.auth.uid);
       
       allow create, update: if isApprovedUser(request.auth.uid) &&
                                 isUserCompanyMember(request.auth.uid, request.resource.data.sellerCompanyId) ||
                                 isUserCompanyMember(request.auth.uid, request.resource.data.buyerCompanyId);
    }
  }
}
