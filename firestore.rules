rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Returns true if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the requesting user is the owner of the document.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Returns true if the user is the designated System Admin.
    function isAdmin() {
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with your actual Firebase Admin UID
      return isSignedIn() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Gets the user document for a given UID.
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    // Gets the company document for a given company ID.
    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    // Checks if the requesting user belongs to a company and that company is approved.
    // This is a key function used to authorize most actions.
    function isApprovedUser() {
      if (!isSignedIn()) {
        return false;
      }
      let userData = getUserData(request.auth.uid).data;
      return userData.companyId != null && getCompanyData(userData.companyId).data.status == 'Approved';
    }

    // --- Rules for User Profiles ---
    match /users/{userId} {
      // Users can create their own profile during signup.
      allow create: if isOwner(userId);
      // Users can read/update their own profile. Admins can read any profile.
      allow read, update: if isOwner(userId) || isAdmin();
    }

    // --- Rules for Companies ---
    match /companies/{companyId} {
      // Any signed-in user can read company data (for contacts, orders, etc.).
      allow read: if isSignedIn();

      // A user can create a company if:
      // 1. They are setting it up for themselves (ownerUid matches their own uid).
      // 2. They are an already approved user creating a company for a new contact (ownerUid is null).
      allow create: if isSignedIn() &&
        (request.resource.data.ownerUid == request.auth.uid ||
        (request.resource.data.ownerUid == null && isApprovedUser()));

      // Only an approved member of that specific company or an Admin can update company details.
      allow update: if (isApprovedUser() && getUserData(request.auth.uid).data.companyId == companyId) || isAdmin();
    }

    // --- Rules for Contacts ---
    match /contacts/{contactId} {
      // Only members of the contact relationship (or an admin) can read it.
      allow read: if (isApprovedUser() && getUserData(request.auth.uid).data.companyId in resource.data.members) || isAdmin();

      // An approved user can create a contact, listing their own company as companyA.
      // This covers both creating an invite and the direct contact flow.
      allow create: if isApprovedUser() && getUserData(request.auth.uid).data.companyId == request.resource.data.companyAId;

      // A contact can be updated if:
      // 1. An approved user is accepting a pending invite (they are becoming companyB).
      // 2. The user is already a member of the established contact.
      allow update: if (isApprovedUser() && request.resource.data.companyBId == getUserData(request.auth.uid).data.companyId && resource.data.status == 'Pending') ||
                      (isApprovedUser() && getUserData(request.auth.uid).data.companyId in resource.data.members);
    }

    // --- Rules for Orders ---
    match /orders/{orderId} {
      // Only members of the order (buyer or seller) or an Admin can read or update it.
      allow read, update: if (isApprovedUser() && getUserData(request.auth.uid).data.companyId in resource.data.members) || isAdmin();

      // An approved user can create an order, but only if they are the seller.
      allow create: if isApprovedUser() && getUserData(request.auth.uid).data.companyId == request.resource.data.sellerCompanyId;
    }
  }
}
