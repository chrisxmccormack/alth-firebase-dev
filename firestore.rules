rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- UTILITY FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // IMPORTANT: Replace with your actual admin UID before deploying.
      return isAuthenticated() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;

      // Allow a user to update their own document, ONLY to add a companyId.
      // Other fields should not be changed by the user after creation.
      allow update: if request.auth.uid == userId &&
                      request.resource.data.companyId != resource.data.companyId &&
                      request.resource.data.firstName == resource.data.firstName;

      // Allow users to create their own user document upon registration.
      allow create: if request.auth.uid == userId;
    }

    // --- COMPANIES ---
    match /companies/{companyId} {
      // Let any authenticated user read company details.
      allow read: if isAuthenticated();

      // The admin has full write access to manage companies (e.g., approve them).
      allow write: if isAdmin();

      // Define specific create rule for non-admins.
      allow create: if isAuthenticated() && (
        // Scenario A: A new user is creating their own company profile.
        (
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.status == 'Pending'
        ) ||
        // Scenario B: An existing, approved user is creating an ownerless company for a contact.
        (
          request.resource.data.ownerUid == null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId != null &&
          get(/databases/$(database)/documents/companies/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId)).data.status == 'Approved'
        )
      );

      // Normal users cannot update company documents.
      allow update: if false;
    }


    // --- CONTACTS ---
    match /contacts/{contactId} {
      // Let a user read a contact document if their company is one of the members.
      allow read: if isAuthenticated() &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;

      // Rule for creating a contact document.
      allow create: if isAuthenticated() {
        // Use `let` bindings to safely get user's company info.
        let userCompanyId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
        let isUserCompanyApproved = get(/databases/$(database)/documents/companies/$(userCompanyId)).data.status == 'Approved';
        let incoming = request.resource.data;

        // Conditions for creating a contact:
        return isUserCompanyApproved &&
               incoming.companyAId == userCompanyId &&
               userCompanyId in incoming.members &&
               // Either it's a pending invite OR a direct connected contact.
               (
                 ( // Invite link creation
                   incoming.status == 'Pending' &&
                   incoming.companyBId == null &&
                   incoming.inviteToken is string &&
                   incoming.expiresAt is timestamp
                 ) ||
                 ( // Direct contact creation
                   incoming.status == 'Connected' &&
                   incoming.companyBId is string &&
                   !('inviteToken' in incoming) &&
                   incoming.companyBId in incoming.members
                 )
               );
      }

      // Rule for updating a contact (i.e., accepting an invite).
      allow update: if isAuthenticated() {
        let userCompanyId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
        let isUserCompanyApproved = get(/databases/$(database)/documents/companies/$(userCompanyId)).data.status == 'Approved';
        let existing = resource.data;
        let incoming = request.resource.data;

        // Conditions for accepting an invite:
        return isUserCompanyApproved &&
               existing.status == 'Pending' &&
               existing.inviteToken != null &&
               incoming.companyBId == userCompanyId &&
               incoming.status == 'Connected' &&
               !('inviteToken' in incoming) &&
               !('expiresAt' in incoming) &&
               existing.companyAId in incoming.members &&
               userCompanyId in incoming.members;
      }
    }

    // --- ORDERS ---
    match /orders/{orderId} {
        // Let a user access an order if their company is one of the members.
        allow read, write: if isAuthenticated() &&
                             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;
    }
  }
}
