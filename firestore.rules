rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- USERS ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- COMPANIES ---
    match /companies/{companyId} {
      // Any authenticated user can create a company profile.
      allow create: if request.auth != null;

      // Authenticated users can read a company's details if that company has been approved.
      // This is necessary for contacts to be able to see each other's company names.
      allow read: if request.auth != null && resource.data.status == 'Approved';

      // Only the designated System Admin can update a company (i.e., to approve it).
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with the actual UID from Firebase Auth.
      allow update: if request.auth != null && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // --- CONTACTS ---
    match /contacts/{contactId} {
      // The user creating the contact must exist in the /users collection
      // and the companyAId they are providing must match their own companyId.
      allow create: if request.auth != null &&
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == request.resource.data.companyAId;

      // A user can read or update a contact if their company is part of the contact.
      allow read, update: if request.auth != null &&
                           exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.companyAId ||
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.companyBId);
    }
  }
}
