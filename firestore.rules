
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function getSystemAdminUid() {
      // CRITICAL: Replace this with your actual Admin User's UID from Firebase Authentication
      // You can find this in the Firebase Console under Authentication -> Users.
      return 'YOUR_ADMIN_UID_HERE';
    }

    function isAdmin() {
      return request.auth.uid == getSystemAdminUid();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the user's data document from the 'users' collection for the currently authenticated user
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Get the company ID associated with the currently authenticated user
    function getCompanyId() {
      return getUserData().companyId;
    }
    
    // Check if the user's company is approved
    function isCompanyApproved() {
      // companyIsApproved is set by an admin.
      return getUserData().companyIsApproved == true;
    }

    // --- COLLECTION RULES ---

    // USERS
    // Users can create their own user document on sign up.
    // They can read and update their own document.
    // Admins can read/write any user document.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
    }

    // COMPANIES
    // Any authenticated user can read all company data (for the directory).
    // A user can create a company document if their UID matches the ownerUid in the document.
    // Only the owner or an admin can update a company.
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if request.resource.data.ownerUid == request.auth.uid;
      allow update: if resource.data.ownerUid == request.auth.uid || isAdmin();
      // No one can delete companies for now.
      allow delete: if false;
    }

    // ORDERS
    // Rules for creating, reading, and updating orders between companies.
    match /orders/{orderId} {
      // Allow read if the user's company is part of the order, or if they are an admin.
      allow read: if isAuthenticated() && (getCompanyId() in resource.data.members || isAdmin());

      // Allow create if the user is authenticated, their company is approved,
      // and their company ID matches the sellerCompanyId in the new order.
      allow create: if isAuthenticated() 
                    && isCompanyApproved()
                    && getCompanyId() == request.resource.data.sellerCompanyId
                    && getCompanyId() in request.resource.data.members;

      // Allow update if the user's company is part of the order, or if they are an admin.
      // This allows both buyer and seller to perform status updates.
      allow update: if isAuthenticated() && (getCompanyId() in resource.data.members || isAdmin());

      // No one can delete orders for now.
      allow delete: if false;
    }
  }
}
