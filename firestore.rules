rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with the actual System Admin UID string.
      return isAuthenticated() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function getCompanyData(companyId) {
        return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function userIsApproved(userId) {
        let userData = getUserData(userId);
        // User must have a companyId to be considered part of the system
        if (!('companyId' in userData) || userData.companyId == null) {
            return false;
        }
        let companyData = getCompanyData(userData.companyId);
        return companyData.status == 'Approved';
    }

    // --- USERS ---
    match /users/{userId} {
      allow read, update: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated();
    }

    // --- COMPANIES ---
    match /companies/{companyId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        (request.resource.data.ownerUid == request.auth.uid) || 
        (userIsApproved(request.auth.uid) && request.resource.data.ownerUid == null)
      );

      allow update: if isSystemAdmin();
    }

    // --- CONTACTS ---
    match /contacts/{contactId} {
      allow read: if isAuthenticated() && getUserData(request.auth.uid).companyId in resource.data.members;

      allow create: if isAuthenticated() && userIsApproved(request.auth.uid)
                      && request.resource.data.companyAId == getUserData(request.auth.uid).companyId;

      allow update: if isAuthenticated() && userIsApproved(request.auth.uid)
                     && resource.data.status == 'Pending'
                     && request.resource.data.status == 'Connected'
                     && request.resource.data.companyBId == getUserData(request.auth.uid).companyId;
    }

    // --- ORDERS ---
    match /orders/{orderId} {
        allow read, update: if isAuthenticated() && getUserData(request.auth.uid).companyId in resource.data.members;
        
        allow create: if isAuthenticated() && userIsApproved(request.auth.uid)
                       && request.resource.data.sellerCompanyId == getUserData(request.auth.uid).companyId;
    }
  }
}
