rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================

    // Is the user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Get the user's data from the /users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Does the user have an associated company?
    function hasCompany() {
      return isSignedIn() && 'companyId' in getUserData() && getUserData().companyId != null;
    }

    // Get the user's company ID
    function getCompanyId() {
      return getUserData().companyId;
    }
    
    // Is the user a system admin?
    // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with your actual admin UID
    function isAdmin() {
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // =================================
    // Collections
    // =================================

    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if isSignedIn();
    }

    match /companies/{companyId} {
      // Any authenticated user can look up company profiles
      allow read: if isSignedIn();

      // Company can be created in two scenarios:
      // 1. By a new user setting up their own company.
      // 2. By an existing user creating a manual contact (ownerless company).
      allow create: if isSignedIn() &&
        (
          // Scenario 1: User creates their own company.
          (request.resource.data.ownerUid == request.auth.uid) ||
          // Scenario 2: Existing user creates an ownerless company for a contact.
          (hasCompany() && request.resource.data.ownerUid == null)
        );

      // Only the system admin can update a company (e.g., to approve it).
      allow update: if isAdmin();
    }

    match /contacts/{contactId} {
      // Allow read if the user's company is part of the contact.
      allow read: if hasCompany() && getCompanyId() in resource.data.members;

      // Allow creating or updating a contact if the user has a company 
      // and their company ID is in the members list of the contact being written.
      allow create, update: if hasCompany() && getCompanyId() in request.resource.data.members;
    }

    match /orders/{orderId} {
      // Allow read if the user's company is a member of the order.
      allow read: if hasCompany() && getCompanyId() in resource.data.members;

      // Allow creating an order if the user is the seller.
      allow create: if hasCompany() && getCompanyId() == request.resource.data.sellerCompanyId;
      
      // Allow updating an order if the user's company is a member.
      allow update: if hasCompany() && getCompanyId() in request.resource.data.members;
    }
  }
}
