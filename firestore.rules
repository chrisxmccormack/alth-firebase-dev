
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    //----------------------------------------------------------------------
    // Users
    // Users can read and write their own document.
    //----------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    //----------------------------------------------------------------------
    // Companies
    //----------------------------------------------------------------------
    match /companies/{companyId} {
      // Is the requesting user the owner of the company document?
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }

      // Any signed-in user can create a company profile.
      allow create: if request.auth != null;
      
      // Only the company owner or system admin can update their own company profile.
      allow update: if isOwner() || isSystemAdmin();
      
      // Any signed-in user can view any 'Approved' company's profile.
      // The company owner can always view their own profile, regardless of status.
      allow read: if (request.auth != null && resource.data.status == 'Approved') || isOwner();
    }

    //----------------------------------------------------------------------
    // Contacts
    //----------------------------------------------------------------------
    match /contacts/{contactId} {
      // Can this user view this contact? (Are they companyA or companyB?)
      allow read: if isPartyInContact(resource.data);

      // An authenticated user can create a contact (an invitation)
      // IF the companyAId in the new document matches their own companyId from their user profile.
      // This is the CRITICAL FIX: we must `get()` the user doc, not use `request.auth.token.companyId`.
      allow create: if request.auth != null && 
                     request.resource.data.companyAId == getUserData(request.auth.uid).companyId;

      // Either party in a contact can update it (e.g., to accept an invite).
      allow update: if isPartyInContact(resource.data);
    }

    //----------------------------------------------------------------------
    // Helper Functions
    //----------------------------------------------------------------------

    // Is the user the system administrator?
    function isSystemAdmin() {
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with your actual Firebase Admin User ID.
      // This UID should be hardcoded here and also set in your .env.local
      return request.auth != null && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }
    
    // Get the user's data document from the /users collection.
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Is the user's company part of this contact document?
    function isPartyInContact(contact) {
      let userCompanyId = getUserData(request.auth.uid).companyId;
      return userCompanyId != null &&
             (userCompanyId == contact.companyAId ||
              userCompanyId == contact.companyBId);
    }
  }
}
