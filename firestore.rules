
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    // Check if a user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user is the designated System Administrator.
    function isSystemAdmin() {
      // CRITICAL: Replace with your actual Admin UID, including the quotes.
      return isSignedIn() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Securely get the data of the currently authenticated user.
    function getRequestingUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if the currently authenticated user has been approved by an admin.
    function isApprovedUser() {
      // Use .get() to safely check for the field, defaulting to false if it doesn't exist.
      return isSignedIn() && getRequestingUserData().get('companyIsApproved', false) == true;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      // A user document is created automatically on sign-up.
      allow create: if isSignedIn();

      // Users can read their own data. Admins can read anyone's data.
      allow read: if isSystemAdmin() || (isSignedIn() && request.auth.uid == userId);

      // An admin can update the `companyIsApproved` flag.
      // A user can update their `companyId` during the one-time company setup.
      allow update: if (isSystemAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyIsApproved'])) ||
                       (isSignedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyId']));

      allow delete: if false;
    }

    match /companies/{companyId} {
      // A user can create their OWN company, but only if they don't already have one.
      // The new company's owner must be the user creating it.
      allow create: if isSignedIn() &&
                       getRequestingUserData().companyId == null &&
                       request.resource.data.ownerUid == request.auth.uid;

      // Only the system admin or the owner of the company can read its details.
      allow read: if isSystemAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerUid);

      // Only the system admin can update a company's status (for approval).
      allow update: if isSystemAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    match /contacts/{contactId} {
      // An approved user can create a contact.
      allow create: if isApprovedUser();

      // A user can read a contact document if their company is listed as a member.
      allow read: if isSignedIn() && getRequestingUserData().companyId in resource.data.members;

      // An approved user can update a contact to accept an invite.
      // This rule is permissive on fields to allow for invite acceptance logic.
      allow update: if isApprovedUser() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'companyBId', 'members', 'inviteToken', 'expiresAt']);

      allow delete: if false;
    }
  }
}
