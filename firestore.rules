rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper Functions
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // CRITICAL: Replace with your actual Admin User UID. Keep the quotes!
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function ownCompanyId() {
      return getUserData().companyId;
    }

    // Check if the user's own company has been approved.
    // This requires a read on the user's company document.
    function isUserApproved() {
      let companyId = ownCompanyId();
      return companyId != null && get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'Approved';
    }

    function isMember(docData) {
      return ownCompanyId() in docData.members;
    }
    
    // =============================================
    // Collection Rules
    // =============================================

    match /users/{userId} {
      // Users can read and update their own user document.
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      // Any signed-in user can create their own user document upon registration.
      allow create: if isSignedIn();
    }

    match /companies/{companyId} {
      // A user can read their own company document OR any company that is approved.
      // This is the key fix to prevent circular permission dependencies.
      allow read: if isSignedIn() && (request.auth.uid == resource.data.ownerUid || resource.data.status == 'Approved');
      
      // A user can create a company for themselves.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Only the System Admin can approve a company.
      // Other updates are disallowed for now for security.
      allow update: if isSystemAdmin() && request.resource.data.status == 'Approved';
    }

    match /contacts/{contactId} {
      allow read: if isUserApproved() && isMember(resource.data);

      // To update a contact, you must be the one accepting the invite.
      allow update: if isUserApproved()
        && request.resource.data.companyBId == ownCompanyId()
        && ownCompanyId() in request.resource.data.members
        && resource.data.status == 'Pending'
        && request.resource.data.status == 'Connected';

      // Creating a contact has two valid scenarios.
      allow create: if isUserApproved() && (
        // Scenario 1: Generating an invite link.
        (
          request.resource.data.status == 'Pending' &&
          request.resource.data.companyAId == ownCompanyId() &&
          request.resource.data.companyBId == null
        ) ||
        // Scenario 2: Direct creation (batched write).
        (
          request.resource.data.status == 'Connected' &&
          request.resource.data.companyAId == ownCompanyId() &&
          // Check that the partner company being created in the same transaction
          // does not have an owner (it's manually created contact data).
          getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyBId)).data.ownerUid == null
        )
      );
    }
    
    match /orders/{orderId} {
      allow read, update: if isUserApproved() && isMember(resource.data);
      allow create: if isUserApproved() 
        && request.resource.data.sellerCompanyId == ownCompanyId()
        && isMember(request.resource.data);
    }
  }
}
