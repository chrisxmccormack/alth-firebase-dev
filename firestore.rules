
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // NOTE: Replace this with your actual Admin UID
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }
    
    function isApprovedUser() {
        // Read from the user's Firestore document.
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        return userDoc.data.companyIsApproved == true;
    }

    // AUTH:
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if isSignedIn();
    }
    
    // COMPANIES:
    match /companies/{companyId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSystemAdmin();
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isSystemAdmin());
    }
    
    // CONTACTS
    match /contacts/{contactId} {
      allow read: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;

      allow create: if (
        // Case 1: Creating an "Unverified" contact (direct create).
        // This is a simple, private record. The user just needs to be signed in
        // and be the designated owner of the new contact document.
        request.resource.data.status == 'Unverified' &&
        isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid
      ) || (
        // Case 2: Creating a "Pending" contact (invite link).
        // This is a higher-security action, as it creates a shareable link.
        // The user must be approved and belong to the company they are creating the link for.
        request.resource.data.status == 'Pending' &&
        isApprovedUser() &&
        request.resource.data.companyAId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
      );

      // Only a connected member can update a contact (e.g. to accept an invite).
      allow update: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in request.resource.data.members;
    }

    // ORDERS
    match /orders/{orderId} {
        allow read, update: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;
        allow create: if isApprovedUser();
    }
  }
}
