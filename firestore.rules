rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================
    // Helper Functions
    // =================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // IMPORTANT: Replace with your actual Admin UID string.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getCompany(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    function isApprovedUser() {
      let companyId = currentUserData().companyId;
      return companyId != null && getCompany(companyId).data.status == 'Approved';
    }

    // =================
    // Collections
    // =================

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId && (
          // Allow create on signup
          !exists(/databases/$(database)/documents/users/$(userId)) ||
          // Allow update only to set companyId once during setup
          (resource.data.companyId == null && request.resource.data.companyId != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyId']))
        )
      );
    }

    match /companies/{companyId} {
      // Any signed-in user can read company data.
      // Security is primarily enforced by Firestore queries on the client-side.
      allow read: if isSignedIn();

      // Create a company:
      // 1. A new user registers their own company.
      // 2. An approved user creates a company for a direct contact.
      allow create: if isSignedIn() && (
        (request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'Pending') ||
        (isApprovedUser() && request.resource.data.ownerUid == null && request.resource.data.status == 'Approved')
      );
      
      // Only the admin can approve a company.
      allow update: if isSignedIn() && isAdmin() &&
                      request.resource.data.status == 'Approved' &&
                      resource.data.status == 'Pending';
      
      allow delete: if false;
    }

    match /contacts/{contactId} {
      // Allow read if the user's company is a member of the contact.
      allow read: if isSignedIn() && resource.data.members.hasAny([currentUserData().companyId]);
      
      // Create a contact (either pending invite or direct creation)
      allow create: if isSignedIn() && isApprovedUser() && request.resource.data.companyAId == currentUserData().companyId && (
        // Case 1: Creating a pending invite link
        request.resource.data.status == 'Pending' ||
        // Case 2: Creating a direct, connected contact (part of a batch write)
        (request.resource.data.status == 'Connected' &&
         // Verify the company being created in the same batch is valid (has no owner)
         getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyBId)).data.ownerUid == null
        )
      );
      
      // Update a contact (only to accept an invite)
      allow update: if isSignedIn() && isApprovedUser() &&
                      resource.data.status == 'Pending' &&
                      request.resource.data.status == 'Connected' &&
                      request.resource.data.companyBId == currentUserData().companyId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyBId', 'status', 'members', 'inviteToken', 'expiresAt']);

      allow delete: if false;
    }
    
    match /orders/{orderId} {
      allow read, update: if isSignedIn() && isApprovedUser() && resource.data.members.hasAny([currentUserData().companyId]);
      allow create: if isSignedIn() && isApprovedUser() && request.resource.data.sellerCompanyId == currentUserData().companyId;
      allow delete: if false;
    }
  }
}
