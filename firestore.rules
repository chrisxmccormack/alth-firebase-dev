rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // CRITICAL: Replace the placeholder text below with your actual Firebase Admin UID.
      // Do not change the variable name 'adminUid'.
      let adminUid = 'REPLACE_WITH_YOUR_ADMIN_UID';
      return isSignedIn() && request.auth.uid == adminUid;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isApprovedUser(userId) {
      let userData = getUserData(userId);
      // Check if user has a company and that company is approved.
      return userData.companyId != null && getCompanyData(userData.companyId).status == 'Approved';
    }


    // --- COLLECTIONS ---

    match /users/{userId} {
      // Users can read/update their own document.
      allow read, update: if isUser(userId);
      // Users can be created during sign-up.
      allow create: if isSignedIn();
    }

    match /companies/{companyId} {
      // Anyone signed in can read company data. This is needed to populate partner info.
      allow read: if isSignedIn();

      // Only an Admin can approve/update companies directly.
      allow update: if isSystemAdmin();

      // A company can be created if:
      // 1. A new user is creating their own company (requesting user is owner).
      // 2. An existing, approved user is creating a new *ownerless* company for a contact.
      allow create: if isSignedIn() &&
                      (request.resource.data.ownerUid == request.auth.uid ||
                       (request.resource.data.ownerUid == null && isApprovedUser(request.auth.uid)));
    }

    match /contacts/{contactId} {
      // A user can read a contact document if their companyId is in the `members` array.
      allow read: if isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;

      // A user can create a contact if:
      // 1. They are an approved user.
      // 2. They are setting their own companyId as companyAId.
      allow create: if isApprovedUser(request.auth.uid) &&
                      request.resource.data.companyAId == getUserData(request.auth.uid).companyId;


      // A user can update a contact (e.g., to accept an invite) if:
      // 1. They are an approved user.
      // 2. The contact is 'Pending'.
      // 3. They are setting their own companyId as companyBId.
      allow update: if isApprovedUser(request.auth.uid) &&
                      resource.data.status == 'Pending' &&
                      request.resource.data.companyBId == getUserData(request.auth.uid).companyId;
    }

    match /orders/{orderId} {
        // An approved user can read an order if their company is a member.
        allow read: if isApprovedUser(request.auth.uid) &&
                      getUserData(request.auth.uid).companyId in resource.data.members;

        // An approved user can create an order if they are the seller.
        allow create: if isApprovedUser(request.auth.uid) &&
                        request.resource.data.sellerCompanyId == getUserData(request.auth.uid).companyId;

        // An approved user can update an order if they are a member.
        allow update: if isApprovedUser(request.auth.uid) &&
                        getUserData(request.auth.uid).companyId in resource.data.members;
    }
  }
}
