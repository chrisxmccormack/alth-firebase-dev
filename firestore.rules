
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserApproved() {
      let userData = getUserData();
      if (!('companyId' in userData) || userData.companyId == null) {
        return false;
      }
      let companyData = get(/databases/$(database)/documents/companies/$(userData.companyId)).data;
      return companyData.status == 'Approved';
    }
    
    function isSystemAdmin() {
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with your actual UID string.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Allow admins to read/write anything for easy management
    match /{path=**} {
      allow read, write: if isSystemAdmin();
    }
    
    // Rules for /users
    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Rules for /companies
    match /companies/{companyId} {
      allow read: if isSignedIn(); // Any signed-in user can read company profiles

      // An authenticated user can create their own company during setup.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      
      // Only the system admin can approve companies by updating the status.
      allow update: if isSystemAdmin() && request.resource.data.keys().hasOnly(['status']);
    }

    // Rules for /contacts
    match /contacts/{contactId} {
      // Users can read contacts where their company is a member.
      allow read: if isSignedIn() && isUserApproved() && getUserData().companyId in resource.data.members;
      
      // Creating an invite link.
      // This is a single write to /contacts.
      allow create: if isSignedIn() && isUserApproved() && request.resource.data.status == 'Pending' && getUserData().companyId == request.resource.data.companyAId;
      
      // Accepting an invite link.
      // This is a single update to /contacts.
      allow update: if isSignedIn() && isUserApproved() && resource.data.status == 'Pending' && request.resource.data.status == 'Connected' && getUserData().companyId == request.resource.data.companyBId;
    }

    // This block handles the specific batch write for "Create Direct Contact"
    match /companies/{newCompanyId} {
      // Allow creating a company if it's part of the direct contact flow (no owner)
      allow create: if isSignedIn() && isUserApproved() && request.resource.data.ownerUid == null;
    }
    match /contacts/{newContactId} {
      // Allow creating the associated contact link if the user is approved and a member.
      allow create: if isSignedIn() && isUserApproved() && request.resource.data.status == 'Connected' && getUserData().companyId in request.resource.data.members;
    }

    // Rules for /orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && isUserApproved() && getUserData().companyId in resource.data.members;
      allow create, update: if isSignedIn() && isUserApproved() && getUserData().companyId in request.resource.data.members;
    }
  }
}
