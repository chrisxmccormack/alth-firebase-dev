rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // --- Helper Functions ---
    // These functions can be used across different rule matches.

    function isSignedIn() {
      return request.auth != null;
    }

    // NOTE: Make sure to replace 'YOUR_ADMIN_UID_HERE' below
    // with the actual Firebase UID of your system administrator.
    function isSystemAdmin() {
      return isSignedIn() && request.auth.uid == 'zcL2mAF06kcAPb68DMIfLmkYROE3';
    }

    // This function safely retrieves the company ID for the currently
    // authenticated user from the /users collection.
    function getMyCompanyId() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.companyId;
    }

    // --- Rules for Collections ---

    match /users/{userId} {
      // Users can create their own user document upon signup.
      allow create: if request.auth.uid == userId;

      // Users can read or update their own data. Admins can read/update anyone.
      allow read, update: if request.auth.uid == userId || isSystemAdmin();
    }

    match /companies/{companyId} {
      // Any signed-in user can view company profiles (e.g., for lookups).
      allow read: if isSignedIn();

      // A user can create a company if they are listed as the owner in the new document.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      
      // Only the company owner or a system admin can update a company profile.
      // This is used for both profile edits and admin approvals.
      allow update: if (get(/databases/$(db)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid) || isSystemAdmin();
    }
    
    match /contacts/{contactId} {
      // A user can read a contact document if their company is either companyA or companyB.
      allow read: if isSignedIn() && (
        resource.data.companyAId == getMyCompanyId() ||
        resource.data.companyBId == getMyCompanyId()
      );

      // A user can create an invite if their company is listed as companyA.
      allow create: if isSignedIn() && request.resource.data.companyAId == getMyCompanyId();

      // An invited user (companyB) can update the contact to accept the invitation.
      // The system admin can also update contacts.
      // We restrict the fields a user can change to prevent them from altering companyA, etc.
      allow update: if (isSignedIn() && 
                       request.resource.data.companyBId == getMyCompanyId() &&
                       request.resource.data.companyAId == resource.data.companyAId &&
                       request.resource.data.status == 'Connected'
                      ) || isSystemAdmin();
    }

    match /orders/{orderId} {
      // --- Order-specific helper functions ---
      function isSeller() {
        return resource.data.sellerCompanyId == getMyCompanyId();
      }
      function isBuyer() {
        return resource.data.buyerCompanyId == getMyCompanyId();
      }
      function incomingData() {
        return request.resource.data;
      }
      // --- End Order-specific functions ---

      allow read: if isSignedIn() && (isSeller() || isBuyer() || isSystemAdmin());

      // Only the seller can create an order.
      allow create: if isSignedIn() && incomingData().sellerCompanyId == getMyCompanyId();

      // Update permissions are based on the user's role (seller/buyer) and the
      // status transition they are trying to make.
      allow update: if isSignedIn() && (
        isSystemAdmin() ||
        // Seller actions
        (isSeller() && incomingData().status in ['Paid', 'Dispatched', 'Cancelled']) ||
        // Buyer actions
        (isBuyer() && incomingData().status in ['Agreed', 'Delivered', 'Disputed', 'InQuery'])
      );
    }
  }
}
