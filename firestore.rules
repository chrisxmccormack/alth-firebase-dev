rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedUser() {
      let userData = getUserData();
      return isSignedIn()
        && userData.companyId != null
        && get(/databases/$(database)/documents/companies/$(userData.companyId)).data.status == 'Approved';
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read, update: if isUser(userId) || isAdmin();
      allow create: if isUser(userId);
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      
      // Allow creation for a user setting up their own company,
      // OR for an approved user creating a manual contact (where owner is null).
      allow create: if (isUser(request.resource.data.ownerUid)) || 
                      (isApprovedUser() && request.resource.data.ownerUid == null);
      
      // Allow updates by admin (for approvals) or an approved company owner.
      allow update: if isAdmin() || (isUser(resource.data.ownerUid) && isApprovedUser());

      allow delete: if false;
    }
    
    match /contacts/{contactId} {
      // Allow read if user's company is a member of the contact.
      allow read: if isApprovedUser() && getUserData().companyId in resource.data.members;
      
      // Allow creation if the user is approved and is creating the contact from their company.
      allow create: if isApprovedUser() && request.resource.data.companyAId == getUserData().companyId;
      
      // Allow update for accepting an invite. User must be approved.
      allow update: if isApprovedUser() && 
                      resource.data.status == 'Pending' && 
                      request.resource.data.status == 'Connected' &&
                      request.resource.data.companyBId == getUserData().companyId;
                      
      allow delete: if false;
    }

    match /orders/{orderId} {
        // Allow read if user's company is a member of the order.
        allow read: if isApprovedUser() && getUserData().companyId in resource.data.members;

        // Allow create if the user is an approved seller creating an order from their company.
        allow create: if isApprovedUser() && request.resource.data.sellerCompanyId == getUserData().companyId;

        // Allow updates if the user is an approved member of the order.
        allow update: if isApprovedUser() && getUserData().companyId in resource.data.members;

        allow delete: if false;
    }
  }
}