rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isRequestingOwnData(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      // Fetches the data for the currently authenticated user.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isUserApproved() {
      // An approved user is one who is signed in, has a companyId, and that company is approved.
      let userData = getUserData();
      return isSignedIn() &&
             userData.companyId != null &&
             get(/databases/$(database)/documents/companies/$(userData.companyId)).data.status == 'Approved';
    }

    function isAdmin() {
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with your actual System Admin UID.
      return isSignedIn() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isRequestingOwnData(userId) || isAdmin();
      
      // Allow user creation if the UID in the path matches the auth token.
      allow create: if isRequestingOwnData(userId);

      // Allow user to update their own profile, or an admin to update any profile.
      allow update: if isRequestingOwnData(userId) || isAdmin();
    }

    match /companies/{companyId} {
      // Any approved user or an admin can read company profiles.
      allow read: if isUserApproved() || isAdmin();

      // Any signed-in user can create a company (for themselves or a contact).
      // The business logic is handled in the server action.
      allow create: if isSignedIn();

      // Only an admin can update a company (e.g., to approve it).
      allow update: if isAdmin();
    }
    
    match /contacts/{contactId} {
      // You can read a contact if your company is one of the members.
      allow read: if isUserApproved() && getUserData().companyId in resource.data.members;

      // Create a contact (for an invite link or direct creation).
      // The user must be approved and creating a contact linked to their own company.
      allow create: if isUserApproved() &&
                       getUserData().companyId == request.resource.data.companyAId;
                       
      // Update a contact (typically for accepting an invite).
      allow update: if isUserApproved() &&
                       // When accepting, you must be adding your company as companyBId.
                       getUserData().companyId == request.resource.data.companyBId &&
                       // And your company ID must now be in the members list.
                       getUserData().companyId in request.resource.data.members;
    }
    
    match /orders/{orderId} {
      // You can read or write an order if your company is one of the members.
      allow read, write: if isUserApproved() &&
                           getUserData().companyId in resource.data.members;
    }
  }
}
