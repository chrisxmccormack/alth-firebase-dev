
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper Functions ----
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isCompanyOwner(companyDoc) {
      return request.auth.uid == companyDoc.data.ownerUid;
    }
    
    function isSystemAdmin() {
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function isMemberOf(doc) {
      // To check membership, we must get the user's companyId from the users collection
      let userCompanyId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
      return userCompanyId in doc.data.members;
    }
    
    // ---- User Rules ----
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
      allow create: if isUserAuthenticated();
    }

    // ---- Company Rules ----
    match /companies/{companyId} {
      allow read: if isUserAuthenticated();
      allow create: if isUserAuthenticated();
      
      // Only the system admin can approve companies. Owners can update their own company details.
      allow update: if isSystemAdmin() || isCompanyOwner(resource);
    }
    
    // ---- Contact Rules ----
    match /contacts/{contactId} {
      // You can get a specific contact if you are a member of it.
      allow get: if isMemberOf(resource);

      // You can list contacts if you are a signed-in user.
      // The query from the client MUST be trusted to filter by the user's companyId.
      allow list: if isUserAuthenticated();
      
      // You can create/update a contact if you are a member of it.
      allow create, update: if isMemberOf(request.resource);
    }

    // ---- Order Rules ----
    match /orders/{orderId} {
      // You can get a specific order if you are a member of it.
       allow get: if isMemberOf(resource);

      // You can list orders if you are a signed-in user.
      // The query from the client MUST be trusted to filter by the user's companyId.
      allow list: if isUserAuthenticated();
      
      // You can create/update an order if you are a member of it.
      allow create, update: if isMemberOf(request.resource);
    }
  }
}
