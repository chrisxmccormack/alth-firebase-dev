
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSystemAdmin() {
      // IMPORTANT: Replace this placeholder with your actual Admin User ID
      return isMe('YOUR_ADMIN_UID_HERE');
    }

    // Safely gets the companyId from the user's document.
    // Returns null if the user doc or companyId doesn't exist.
    function getMyCompanyId() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      if (userDoc == null || !('companyId' in userDoc.data)) {
        return null;
      }
      return userDoc.data.companyId;
    }

    // Checks if the current user's company is a member of the document.
    function amIMember(docData) {
      let myCompany = getMyCompanyId();
      // A user must have a company, and that companyId must be in the members list.
      return myCompany != null && 'members' in docData && docData.members is list && myCompany in docData.members;
    }
    
    // --- Rules Definitions ---

    match /users/{userId} {
      // Users can read and write their own user document.
      allow read, write: if isMe(userId);
    }

    match /companies/{companyId} {
      // Any signed-in user can read company profiles (for contact lists, etc.)
      allow read: if isSignedIn();
      // A user can create a company document only if they are the owner.
      allow create: if isMe(request.resource.data.ownerUid);
      // The system admin can approve companies. Owners cannot change status.
      allow update: if isSystemAdmin() || 
                     (isMe(resource.data.ownerUid) && request.resource.data.status == resource.data.status);
    }
    
    match /contacts/{contactId} {
       // Users can read/update a contact if their company is a member.
       allow read, update: if amIMember(resource.data);
       // A user can create a contact, listing their own company as companyA.
       allow create: if getMyCompanyId() == request.resource.data.companyAId;
    }

    match /orders/{orderId} {
      // Users can read an order if their company is a member. Admins can read all orders.
      allow read: if amIMember(resource.data) || isSystemAdmin();
      
      // A user can create an order only if they are the seller.
      allow create: if getMyCompanyId() == request.resource.data.sellerCompanyId;

      // --- Granular Update Logic ---
      function isSeller() {
        return getMyCompanyId() == resource.data.sellerCompanyId;
      }

      function isBuyer() {
        return getMyCompanyId() == resource.data.buyerCompanyId;
      }

      function validSellerUpdate() {
        return request.resource.data.status in ['Paid', 'Dispatched'] ||
               (request.resource.data.status == 'Cancelled' && resource.data.status in ['Draft', 'Agreed']);
      }

      function validBuyerUpdate() {
        return (request.resource.data.status == 'Agreed' && resource.data.status == 'Draft') ||
               (request.resource.data.status == 'Delivered' && resource.data.status == 'Dispatched') ||
               (request.resource.data.status == 'Disputed' && resource.data.status == 'Delivered');
      }

      allow update: if (isSeller() && validSellerUpdate()) ||
                       (isBuyer() && validBuyerUpdate())  ||
                       isSystemAdmin();
    }
  }
}
