
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // Ensure you replace 'YOUR_ADMIN_UID_HERE' with your actual admin UID.
      return isSignedIn() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Safely gets a user's data document.
    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // Safely gets the requesting user's data. Returns null if not found.
    function getRequestingUserData() {
      if (!isSignedIn()) {
        return null;
      }
      return getUserDoc(request.auth.uid).data;
    }

    // Checks if the requesting user is part of an approved company.
    function isRequestingUserApproved() {
        let userData = getRequestingUserData();
        if (userData == null || !('companyId' in userData) || userData.companyId == null) {
            return false;
        }
        let companyData = get(/databases/$(database)/documents/companies/$(userData.companyId)).data;
        return companyData.status == 'Approved';
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      // Allow a user to be created on signup.
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      // Any authenticated user can read company profiles (e.g., for contacts).
      allow read: if isSignedIn();

      // Allow create if:
      // 1. A new user is creating their own company profile (owner matches).
      // 2. An approved existing user is creating a manual contact (owner is null).
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        (request.resource.data.ownerUid == null && isRequestingUserApproved())
      );
      
      // Allow update if user is the company owner or system admin.
      allow update: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isSystemAdmin();
    }

    match /contacts/{contactId} {
      // Allow read/update if the user's company is a member of the contact.
      allow read, update: if isRequestingUserApproved() && getRequestingUserData().companyId in resource.data.members;

      // Allow create if the user is approved and their companyId is being added to the members list.
      allow create: if isRequestingUserApproved() && getRequestingUserData().companyId in request.resource.data.members;
    }

    match /orders/{orderId} {
      // Allow read/update if the user's company is a member of the order.
      allow read, update: if isRequestingUserApproved() && getRequestingUserData().companyId in resource.data.members;

      // Allow create if the user is approved and their companyId is the seller.
      allow create: if isRequestingUserApproved() && getRequestingUserData().companyId == request.resource.data.sellerCompanyId;
    }
  }
}
