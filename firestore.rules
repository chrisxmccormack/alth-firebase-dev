
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: Insecure rules for development only.
    // These rules allow any authenticated user to read and write to all collections.
    // You MUST tighten these rules before deploying to production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
