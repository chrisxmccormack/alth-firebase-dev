
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the system admin.
    // The admin UID is a placeholder that should be replaced before deployment.
    function isSystemAdmin() {
      return request.auth != null && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }
    
    // Helper function to get the current user's company ID from their user document.
    function getUserCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    // Helper function to check if the current user is a party to a contact.
    function isPartyInContact() {
      let userCompanyId = getUserCompanyId();
      return userCompanyId != null &&
             (userCompanyId == resource.data.companyAId ||
              userCompanyId == resource.data.companyBId);
    }

    // Users can read and write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Company rules
    match /companies/{companyId} {
      // Any authenticated user can create a company profile.
      allow create: if request.auth != null;
      
      // Users can read their own company document.
      // Any user can read any other company's document if it has been approved.
      allow read: if request.auth != null &&
                     (getUserCompanyId() == companyId ||
                      (exists(/databases/$(database)/documents/companies/$(companyId)) &&
                       get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'Approved'));
                       
      // Only the system admin can update a company (to approve it).
      allow update: if isSystemAdmin();
    }

    // Contacts rules
    match /contacts/{contactId} {
      // A user can read or update a contact document if their company is part of it.
      allow read, update: if isPartyInContact();
      
      // A user can create a contact document if they are authenticated and the
      // creating company (companyAId) matches their own company ID.
      allow create: if request.auth != null &&
                     getUserCompanyId() == request.resource.data.companyAId;
    }
  }
}
