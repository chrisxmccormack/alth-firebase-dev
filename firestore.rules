
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSystemAdmin() {
      // IMPORTANT: Replace this placeholder with your actual System Admin UID.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getCompanyId() {
        return getUserData().companyId;
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSystemAdmin();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSystemAdmin() ||
                     (get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid);
    }
    
    match /contacts/{contactId} {
       allow read: if isSignedIn() && (
                    resource.data.companyAId == getCompanyId() ||
                    resource.data.companyBId == getCompanyId()
                  );
       allow create: if request.resource.data.companyAId == getCompanyId();
       allow update: if (
                        (resource.data.companyAId == getCompanyId() || resource.data.companyBId == getCompanyId()) ||
                        (request.resource.data.companyBId == getCompanyId() && resource.data.companyBId == null)
                     );
    }

    // --- ORDERS ---
    function isSeller(order)  {
      return getCompanyId() == order.sellerCompanyId;
    }
    function isBuyer(order)   {
      return getCompanyId() == order.buyerCompanyId;
    }

    // Check that only fields the user is allowed to change are being changed.
    function sellerUpdatableFields() {
      return [
        'status', 'trackingId', 'lines', 'totals', 
        'paymentMethod', 'currency', 'updatedAt'
      ];
    }
    function buyerUpdatableFields() {
      return ['status', 'updatedAt'];
    }

    function validSellerUpdate() {
      let before = resource.data;
      let after = request.resource.data;

      // Allow if only permitted fields are being updated
      let fieldsValid = request.writeFields.hasOnly(sellerUpdatableFields());

      // Validate status transitions
      let statusJumpAllowed =
        (before.status == 'Draft' && after.status in ['Draft', 'Cancelled']) ||
        (before.status == 'Agreed' && after.status in ['Paid', 'Dispatched', 'Cancelled']) ||
        (before.status == 'Paid' && after.status == 'Dispatched') ||
        (before.status == 'InQuery' && after.status in ['Completed', 'Cancelled']);

      return fieldsValid && statusJumpAllowed;
    }

    function validBuyerUpdate() {
      let before = resource.data;
      let after = request.resource.data;

      let fieldsValid = request.writeFields.hasOnly(buyerUpdatableFields());

      let statusJumpAllowed =
        (before.status == 'Draft' && after.status == 'Agreed') ||
        (before.status == 'Dispatched' && after.status == 'Delivered') ||
        (before.status == 'Delivered' && after.status in ['Completed', 'Disputed', 'InQuery']) ||
        (before.status == 'InQuery' && after.status in ['Completed', 'Disputed']);

      return fieldsValid && statusJumpAllowed;
    }

    match /orders/{orderId} {
      allow read:   if isSignedIn() && (isSeller(resource.data) || isBuyer(resource.data) || isSystemAdmin());
      allow create: if isSignedIn() && isSeller(request.resource.data);
      allow update: if isSignedIn() && (
                       isSystemAdmin() ||
                       (isSeller(resource.data) && validSellerUpdate()) ||
                       (isBuyer(resource.data)  && validBuyerUpdate())
                    );
    }
  }
}
