
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isApprovedUser() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             userDoc.data.get('companyIsApproved', false) == true;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // IMPORTANT: Replace with your actual System Admin UID
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }
    
    // USERS
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isAdmin() && 'companyIsApproved' in request.resource.data) || 
                       (isSignedIn() && request.auth.uid == userId && 'companyId' in request.resource.data);
    }

    // COMPANIES
    match /companies/{companyId} {
      // Allow any signed-in user to read company data. This is needed to resolve company names in various parts of the UI (e.g., invites, orders).
      // The crucial data is protected by other rules.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
    
    // CONTACTS
    match /contacts/{contactId} {
      allow read: if isApprovedUser() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;

      allow create: if (
        // Case 1: Creating a "Pending" contact (invite link). Must be an approved user.
        request.resource.data.status == 'Pending' &&
        isApprovedUser() &&
        request.resource.data.companyAId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
      ) || (
        // Case 2: Creating an "Unverified" contact (direct create). Only needs to be signed in.
        request.resource.data.status == 'Unverified' &&
        isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid
      );
      
      allow update: if (
        // Case for accepting an invite
        isApprovedUser() &&
        resource.data.status == 'Pending' && 
        request.resource.data.status == 'Connected' &&
        request.resource.data.companyBId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId &&
        !('inviteToken' in request.resource.data) // ensure token is removed
      );
    }

    // ORDERS
    match /orders/{orderId} {
        allow read: if isApprovedUser() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;
        allow create: if isApprovedUser() && request.resource.data.sellerCompanyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
        allow update: if isApprovedUser() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members;
    }
  }
}
