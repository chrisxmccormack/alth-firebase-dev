rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // --- Helper Functions ---
    function isSystemAdmin() {
      // IMPORTANT: Replace with your actual UID before deploying
      return request.auth.uid == 'zcL2mAF06kcAPb68DMIfLmkYROE3';
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    // This function returns the user's document from the /users collection
    function userDoc() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid));
    }
    
    // This function returns the user's company ID, but only if the user doc and companyId exist
    function userCompanyId() {
      return userDoc().data.companyId;
    }

    // This function checks if the user has a company associated with them
    function userHasCompany() {
      return exists(/databases/$(db)/documents/users/$(request.auth.uid)) && userDoc().data.companyId != null;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Users can read, create, and update their own user document.
      allow read, create, update: if isSignedIn() && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      // Any signed-in user can read company data. This is needed for populating partner info.
      allow read: if isSignedIn();

      // Allow creating a company if:
      // 1. You are the owner of the new company being created.
      // 2. You already have a company and are creating an ownerless company (for the 'Add Contact' feature).
      allow create: if isSignedIn() && 
        (request.resource.data.ownerUid == request.auth.uid || 
         (request.resource.data.ownerUid == null && userHasCompany()));
      
      // Only the System Admin can update a company (e.g., to approve it).
      allow update: if isSystemAdmin();
    }

    match /contacts/{contactId} {
      // Allow read if the user's company is in the 'members' array.
      allow read: if userHasCompany() && userCompanyId() in resource.data.members;

      // Allow create if the user is creating the contact for their own company.
      // This covers both invites and direct creation.
      allow create: if userHasCompany() && request.resource.data.companyAId == userCompanyId();
      
      // Allow update only for accepting an invite. The user must be the invited party (companyB).
      allow update: if userHasCompany() &&
                       resource.data.status == 'Pending' &&
                       request.resource.data.status == 'Connected' &&
                       request.resource.data.companyBId == userCompanyId();
    }

    match /orders/{orderId} {
      // Allow read if the user's company is in the 'members' array.
      allow read: if userHasCompany() && userCompanyId() in resource.data.members;

      // Allow create if the user's company is the seller.
      allow create: if userHasCompany() && request.resource.data.sellerCompanyId == userCompanyId();

      // Allow updates based on role and valid status transitions.
      allow update: if userHasCompany() && (
        (userCompanyId() == resource.data.sellerCompanyId && isSellerOrderUpdate(request, resource)) ||
        (userCompanyId() == resource.data.buyerCompanyId && isBuyerOrderUpdate(request, resource))
      );
    }
    
    // --- Order Update Logic Functions ---
    
    function isSellerOrderUpdate(request, resource) {
      let oldStatus = resource.data.status;
      let newStatus = request.resource.data.status;
      return (oldStatus == 'Agreed' && newStatus == 'Paid') ||
             (oldStatus == 'Paid' && newStatus == 'Dispatched') ||
             (newStatus == 'Cancelled' && oldStatus in ['Draft', 'Agreed']);
    }
    
    function isBuyerOrderUpdate(request, resource) {
      let oldStatus = resource.data.status;
      let newStatus = request.resource.data.status;
      // Allow disputing an Escrow order within the deadline
      let canDispute = resource.data.paymentMethod == 'Escrow' && 
                       resource.data.escrowDeadline != null && 
                       resource.data.escrowDeadline > request.time;
                       
      return (oldStatus == 'Draft' && newStatus == 'Agreed') ||
             (oldStatus == 'Dispatched' && newStatus == 'Delivered') ||
             (oldStatus == 'Delivered' && newStatus == 'Disputed' && canDispute) ||
             (oldStatus == 'Delivered' && newStatus == 'InQuery');
    }
  }
}
