rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getUserCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function isSystemAdmin() {
      // TODO: IMPORTANT! Replace this placeholder with the actual System Admin UID.
      // You can find this value in your .env.local file (NEXT_PUBLIC_SYSTEM_ADMIN_UID).
      // For security, this value must be hardcoded here as security rules cannot access environment variables.
      return request.auth != null && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function isParty(contact) {
      let userCompanyId = getUserCompanyId();
      return request.auth != null &&
        (userCompanyId == contact.companyAId ||
         userCompanyId == contact.companyBId);
    }

    // Users can read and write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A company document can be created by any authenticated user.
    // It can only be read by the user associated with that company.
    // It can only be updated by a system admin (via the admin panel).
    match /companies/{companyId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && getUserCompanyId() == companyId;
      allow update: if isSystemAdmin();
    }

    // A contact can be created by an authenticated user who belongs to companyA.
    // It can be read or updated by either party of the connection.
    match /contacts/{contactId} {
      allow read: if isParty(resource.data);
      allow create: if request.auth != null && request.resource.data.companyAId == getUserCompanyId();
      // Allow update if user is creator (companyA) OR if they are accepting the invite (setting their companyBId).
      allow update: if request.auth != null &&
        (getUserCompanyId() == resource.data.companyAId ||
        (resource.data.status == 'Pending' && request.resource.data.companyBId == getUserCompanyId()));
    }
  }
}
