rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with your actual System Admin UID.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isCompanyApproved(companyId) {
        return getCompanyData(companyId).status == 'Approved';
    }
    
    function isUserApproved() {
      let userData = getUserData(request.auth.uid);
      return userData.companyId != null && isCompanyApproved(userData.companyId);
    }
    
    function userOwnsCompany(companyId) {
      return getCompanyData(companyId).ownerUid == request.auth.uid;
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read, write: isSignedIn() && request.auth.uid == userId;
    }

    // ===== COMPANIES =====
    match /companies/{companyId} {
      allow read: isSignedIn();
      
      allow update: isSystemAdmin() || (userOwnsCompany(companyId) && isCompanyApproved(companyId));
      
      allow create: isSystemAdmin() || 
                    (isSignedIn() && request.resource.data.ownerUid == request.auth.uid) ||
                    (isUserApproved() && !('ownerUid' in request.resource.data));
    }

    // ===== CONTACTS =====
    match /contacts/{contactId} {
        allow read: isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;

        // Logic for creating an invite link OR a direct connection (batch write)
        allow create: (isSignedIn() && isUserApproved() &&
                      request.resource.data.companyAId == getUserData(request.auth.uid).companyId &&
                      request.resource.data.status == 'Pending') 
                      ||
                      (isUserApproved() && 
                      request.resource.data.status == 'Connected' &&
                      getUserData(request.auth.uid).companyId in request.resource.data.members);

        // Logic for accepting an invite
        allow update: isSignedIn() && isUserApproved() &&
                      resource.data.status == 'Pending' &&
                      request.resource.data.status == 'Connected' &&
                      request.resource.data.companyBId == getUserData(request.auth.uid).companyId &&
                      !('inviteToken' in request.resource.data);
    }

    // ===== ORDERS =====
    match /orders/{orderId} {
        allow read: isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;
        
        allow create: isSignedIn() && isUserApproved() &&
                      request.resource.data.sellerCompanyId == getUserData(request.auth.uid).companyId;
        
        allow update: isSignedIn() && isUserApproved() &&
                      getUserData(request.auth.uid).companyId in resource.data.members;
    }
  }
}
