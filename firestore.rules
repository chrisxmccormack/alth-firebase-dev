
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSystemAdmin() {
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' below with the actual UID of the system administrator.
      // Do NOT remove the single quotes around the UID string.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }
    
    function isCompanyOwner(companyId) {
      return isSignedIn() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid;
    }

    function isApprovedUser() {
      let userCompanyId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
      return userCompanyId != null && get(/databases/$(database)/documents/companies/$(userCompanyId)).data.status == 'Approved';
    }
    
    function isContactMember(contactId) {
       return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in get(/databases/$(database)/documents/contacts/$(contactId)).data.members;
    }

    function isOrderMember(orderId) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in get(/databases/$(database)/documents/orders/$(orderId)).data.members;
    }
    
    // --- Collection Rules ---

    match /users/{userId} {
      allow read, write: if (isSignedIn() && request.auth.uid == userId) || isSystemAdmin();
    }
    
    match /companies/{companyId} {
      allow read: if isSignedIn() || isSystemAdmin();
      allow write: if isSystemAdmin();
      
      // A signed-in user can create a company for themselves.
      // An approved user can create a new company for a direct contact.
      allow create: if (isSignedIn() && request.resource.data.ownerUid == request.auth.uid) || 
                       (isApprovedUser() && request.resource.data.ownerUid == null);
      
      // Only the company owner can update their own company details.
      allow update: if isCompanyOwner(companyId);
    }

    match /contacts/{contactId} {
        allow read, write: if isSystemAdmin();
        allow read: if isContactMember(contactId);
        allow create: if isApprovedUser();
        allow update: if isContactMember(contactId);
    }
    
    match /orders/{orderId} {
        allow read, write: if isSystemAdmin();
        allow read, update: if isOrderMember(orderId);
        allow create: if isApprovedUser();
    }
  }
}
