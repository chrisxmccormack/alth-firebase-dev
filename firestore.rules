rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get the user's company ID from the /users collection
    function getUserCompanyId(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.companyId;
    }

    // Helper function to check if the user is the system admin
    function isSystemAdmin() {
      // IMPORTANT: You must replace 'YOUR_ADMIN_UID_HERE' with your actual Firebase Admin User UID
      // for this rule to work. See the README.md for instructions.
      return request.auth != null && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    //------------------------------------------------------------
    // User Rules
    //------------------------------------------------------------
    match /users/{userId} {
      // Users can read and write to their own user document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    //------------------------------------------------------------
    // Company Rules
    //------------------------------------------------------------
    match /companies/{companyId} {
      // Any authenticated user can create a company profile
      allow create: if request.auth != null;

      // Only the system admin can update a company (e.g., to approve it)
      allow update: if isSystemAdmin();
      
      // Any authenticated user can read details of an *approved* company.
      // This is necessary for contacts to see each other's company info.
      // A company's owner can always read their own company doc, regardless of status.
      allow read: if request.auth != null && 
                    (resource.data.status == 'Approved' || request.auth.uid == resource.data.ownerUid);
    }
    
    //------------------------------------------------------------
    // Contact Rules
    //------------------------------------------------------------
    match /contacts/{contactId} {
      // A user can create a contact record only if the companyAId in the new
      // document matches the companyId stored in their user document.
      allow create: if request.auth != null &&
                      request.resource.data.companyAId == getUserCompanyId(request.auth.uid);

      // A user can update a contact record (e.g., to accept an invite)
      // if they are either company A or will become company B.
      allow update: if request.auth != null &&
                      (getUserCompanyId(request.auth.uid) == resource.data.companyAId ||
                      (resource.data.companyBId == null && getUserCompanyId(request.auth.uid) == request.resource.data.companyBId));

      // A user can read a contact record if they are either company A or company B.
      allow read: if request.auth != null &&
                    (getUserCompanyId(request.auth.uid) == resource.data.companyAId ||
                    getUserCompanyId(request.auth.uid) == resource.data.companyBId);
    }
  }
}
