rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================

    function isSystemAdmin() {
      // IMPORTANT: Replace 'YOUR_ADMIN_UID_HERE' with the actual UID from your Firebase project.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMyUserDocument(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserCompanyId(uid) {
        // This function returns the companyId from a user's document.
        // It's designed to be used in rules that will fail gracefully if the path doesn't exist.
        return get(/databases/$(database)/documents/users/$(uid)).data.companyId;
    }

    function isMemberOf(doc) {
      // This function checks if the currently authenticated user's company
      // is listed in the 'members' array of a given document (e.g., an order or contact).
      // It will safely return false if the user document or companyId does not exist.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists &&
             'companyId' in userDoc.data &&
             userDoc.data.companyId in doc.data.members;
    }

    // =================================
    // Collection Rules
    // =================================

    match /users/{userId} {
      // A user can create, read, and write to their own user document.
      allow read, write: if isMyUserDocument(userId);
    }

    match /companies/{companyId} {
      // Anyone signed in can read basic company info (needed for invites/lookups).
      allow read: if isSignedIn();

      // A user can create a company document for themselves.
      allow create: if request.auth.uid == request.resource.data.ownerUid
                      && request.resource.data.status == 'Pending';

      // An owner can update their company, but NOT the status. The admin can update anything.
      allow update: if (request.auth.uid == resource.data.ownerUid && request.resource.data.status == resource.data.status)
                    || isSystemAdmin();
    }

    match /contacts/{contactId} {
      // Allow read if user is a member of the contact or is an admin.
      allow read: if isMemberOf(resource) || isSystemAdmin();

      // Allow creating a contact if you are companyA.
      allow create: if request.resource.data.companyAId == getUserCompanyId(request.auth.uid);

      // Allow companyB to accept the invite, or admin to update.
      allow update: if (request.resource.data.companyBId == getUserCompanyId(request.auth.uid)) || isSystemAdmin();
    }

    match /orders/{orderId} {
      // Allow read if user's company is a member of the order or is an admin.
      allow read: if isMemberOf(resource) || isSystemAdmin();

      // Allow creating an order if you are the seller.
      allow create: if request.resource.data.sellerCompanyId == getUserCompanyId(request.auth.uid);

      // Allow updates only by members of the order or admins.
      // The server-side actions are responsible for validating the specific status transitions.
      allow update: if isMemberOf(resource) || isSystemAdmin();
    }
  }
}
