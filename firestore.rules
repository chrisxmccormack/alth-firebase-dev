rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getAdminUid() {
        // IMPORTANT: Replace this placeholder with your actual Firebase Admin UID
        return 'YOUR_ADMIN_UID_HERE';
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == getAdminUid();
    }
    
    // Get the user's data from the /users collection
    function getUserData(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Get a company's data from the /companies collection
    function getCompanyData(companyId) {
        return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }
    
    // Check if a user belongs to a company and that company is approved
    function isApprovedMemberOf(companyId) {
        let userData = getUserData(request.auth.uid);
        let companyData = getCompanyData(companyId);
        return userData.companyId == companyId && companyData.status == 'Approved';
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId);
      allow update: if isUser(userId) || isAdmin();
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      
      // Allow create if:
      // 1. The user is creating their own company for the first time.
      // 2. An approved user is creating a new, ownerless company (for a direct contact).
      allow create: if (isUser(request.resource.data.ownerUid) && getUserData(request.auth.uid).companyId == null)
                      || (request.resource.data.ownerUid == null && isApprovedMemberOf(getUserData(request.auth.uid).companyId));

      // Allow update if:
      // 1. The user is an admin.
      // 2. The user is the owner of the company (but can't change status).
      allow update: if isAdmin()
                      || (isUser(resource.data.ownerUid) && request.resource.data.status == resource.data.status);

      allow delete: if false;
    }

    match /contacts/{contactId} {
      allow read, update: if isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;

      // Allow create if the user is an approved member of the company initiating the contact.
      allow create: if isSignedIn() && isApprovedMemberOf(request.resource.data.companyAId);
      
      allow delete: if false;
    }

    match /orders/{orderId} {
        allow read, update: if isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;
        
        // Allow create if the user is an approved seller.
        allow create: if isSignedIn() && isApprovedMemberOf(request.resource.data.sellerCompanyId);

        allow delete: if false;
    }
  }
}
