
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSystemAdmin() {
      return request.auth != null && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function getUsersCompanyId(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data.companyId;
    }

    function isPartyIn(contactData) {
        let userCompanyId = getUsersCompanyId(request.auth.uid);
        return request.auth != null &&
           (userCompanyId == contactData.companyAId ||
            userCompanyId == contactData.companyBId);
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isSystemAdmin() || resource.data.status == 'Approved');
      allow update: if isSystemAdmin();
    }

    match /contacts/{contactId} {
        allow read: if isPartyIn(resource.data);
        allow create: if request.auth != null &&
                       request.resource.data.companyAId == getUsersCompanyId(request.auth.uid);
        allow update: if request.auth != null && 
          (
            // Allow a user to accept an invite by adding their companyId
            (resource.data.status == 'Pending' && request.resource.data.companyBId == getUsersCompanyId(request.auth.uid)) ||
            // Allow existing parties to update
            isPartyIn(resource.data)
          );
    }
  }
}
