
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSystemAdmin() {
      // IMPORTANT: Replace with your actual Admin UID from Firebase Authentication, keeping the single quotes.
      let adminUid = 'YOUR_ADMIN_UID_HERE';
      return request.auth.uid == adminUid;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    // Safely gets the currently signed-in user's companyId
    function userCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }
    
    // Safely gets the status of a given company
    function companyStatus(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.status;
    }

    // --- COLLECTIONS ---

    match /users/{userId} {
      // Users can create their own doc on signup, and can read/update their own doc.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read, update: if isSignedIn() && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      
      // Allow creation if:
      // 1. A new user is creating their own company.
      // 2. An approved user is creating an ownerless company for a new contact.
      allow create: if isSignedIn() && (
        (request.resource.data.ownerUid == request.auth.uid &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == null) ||
        (request.resource.data.ownerUid == null &&
         companyStatus(userCompanyId()) == 'Approved')
      );
      
      // Only the system admin can update a company (to approve it).
      allow update: if isSystemAdmin();
    }

    match /contacts/{contactId} {
      // Allow read for invite validation or if user is a member of the contact.
      allow read: if resource.data.status == 'Pending' || 
                   (isSignedIn() && userCompanyId() in resource.data.members);
      
      // Allow listing contacts only if the user is a member.
      allow list: if isSignedIn() && userCompanyId() in resource.data.members;

      // Allow creating a contact if the user belongs to an approved company.
      allow create: if isSignedIn() && companyStatus(userCompanyId()) == 'Approved';

      // Allow updating a contact only to accept an invite.
      allow update: if isSignedIn() &&
                       resource.data.status == 'Pending' &&
                       request.resource.data.status == 'Connected' &&
                       companyStatus(userCompanyId()) == 'Approved' &&
                       request.resource.data.companyBId == userCompanyId();
    }

    match /orders/{orderId} {
        // Allow reading/listing orders if the user's company is a member.
        allow list, read: if isSignedIn() && userCompanyId() in resource.data.members;

        // Allow creating orders if the user's company is approved.
        allow create: if isSignedIn() && companyStatus(userCompanyId()) == 'Approved';

        // Allow updating orders if the user's company is a member.
        allow update: if isSignedIn() && userCompanyId() in resource.data.members;
    }
  }
}
