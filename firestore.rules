rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper Functions
    // =============================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getMyCompanyId() {
      return getUserDoc().data.companyId;
    }

    // IMPORTANT: REPLACE 'YOUR_ADMIN_UID_HERE' with your actual Firebase UID.
    // This value MUST be in quotes. For example: 'Abc123xyz...'
    function isSystemAdmin() {
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // =============================================
    // /users/{userId}
    // =============================================
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || isSystemAdmin();
      allow create: if request.auth.uid == userId;
    }

    // =============================================
    // /companies/{companyId}
    // =============================================
    match /companies/{companyId} {
      // Anyone can read an approved company profile.
      // The owner can always read their own company, regardless of status.
      allow read: if (resource.data.status == 'Approved' && isSignedIn()) ||
                     (userExists() && resource.data.ownerUid == request.auth.uid) ||
                     isSystemAdmin();

      // A user can create a company for themself.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Only the admin can change the status to 'Approved'.
      // The incoming resource must have the 'status' field.
      allow update: if isSystemAdmin() && 'status' in request.resource.data;
    }

    // =============================================
    // /contacts/{contactId}
    // =============================================
    match /contacts/{contactId} {
      // Users can read/delete a contact if their company is a member.
      allow read, delete: if userExists() && getMyCompanyId() in resource.data.members;

      // Create: The creator's companyId must be in the 'members' array.
      allow create: if userExists() && getMyCompanyId() in request.resource.data.members;

      // Update: The user's companyId must be in the 'members' array.
      allow update: if userExists() && getMyCompanyId() in resource.data.members;
    }

    // =============================================
    // /orders/{orderId}
    // =============================================
    match /orders/{orderId} {
       // Users can read an order if their company is a member.
      allow read: if (userExists() && getMyCompanyId() in resource.data.members) || isSystemAdmin();
      
      // The creator's company must be the seller.
      allow create: if userExists() && request.resource.data.sellerCompanyId == getMyCompanyId();

      // Any member of the order can update it. Specific actions are controlled by the UI.
      allow update: if (userExists() && getMyCompanyId() in resource.data.members) || isSystemAdmin();
    }
  }
}
