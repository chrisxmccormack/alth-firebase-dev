
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isUserAuthenticated() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function userHasCompany(userId) {
       return getUserData(userId).companyId != null;
    }

    function isOwner(companyId) {
      return isUserAuthenticated() && getUserData(request.auth.uid).companyId == companyId;
    }
    
    function isPartyToContact(contact) {
      let userCompanyId = getUserData(request.auth.uid).companyId;
      return userCompanyId != null && 
             (userCompanyId == contact.companyAId || userCompanyId == contact.companyBId);
    }
    
    function isApprovedCompany(companyId) {
        return get(/databases/$(database)/documents/companies/$(companyId)).data.status == "Approved";
    }

    // Collection Rules
    match /users/{userId} {
      allow read, write: if isUserAuthenticated() && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      // Any authenticated user can create a company profile for themselves.
      allow create: if isUserAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      
      // Only the owner of an approved company or any system admin can read company data.
      // We also allow reading other *approved* companies.
      allow read: if isUserAuthenticated() && (isOwner(companyId) || isSystemAdmin() || isApprovedCompany(companyId));
      
      // Only the System Admin can update a company (to approve it).
      allow update: if isSystemAdmin();
    }
    
    match /contacts/{contactId} {
      // A user can create a contact invite if they belong to the company initiating it.
      allow create: if isUserAuthenticated() &&
                     userHasCompany(request.auth.uid) &&
                     request.resource.data.companyAId == getUserData(request.auth.uid).companyId;

      // Anyone who is party to the contact can read it.
      allow read: if isUserAuthenticated() &&
                   userHasCompany(request.auth.uid) &&
                   isPartyToContact(resource.data);
                   
      // Anyone who is party to the contact can update it (e.g., to accept the invite).
      allow update: if isUserAuthenticated() &&
                     userHasCompany(request.auth.uid) &&
                     isPartyToContact(resource.data);
    }
  }
}
