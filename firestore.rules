rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // Helper Functions
    // =================================================================

    function isSystemAdmin() {
      // IMPORTANT: You must replace this with your admin UID in the README and .env.local
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // =================================================================
    // Collection Rules
    // =================================================================

    match /users/{userId} {
      allow read, update, create: if request.auth.uid == userId || isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if request.auth.uid == request.resource.data.ownerUid;
      allow update: if isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    match /contacts/{contactId} {
      // Logic to check membership is inlined here, as get() is not allowed in functions.
      allow read: if (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members)
        || isSystemAdmin()
      );

      // Inlined logic for create/update.
      allow create: if exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == request.resource.data.companyAId;
      allow update: if exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == request.resource.data.companyBId &&
                     resource.data.status == 'Pending';

      allow delete: if isSystemAdmin();
    }

    match /orders/{orderId} {
       // Logic to check membership is inlined here.
      allow read: if (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId in resource.data.members)
        || isSystemAdmin()
      );

       // Inlined logic for create.
      allow create: if exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == request.resource.data.sellerCompanyId;

       // Inlined logic for update.
      allow update: if (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.sellerCompanyId &&
           isValidSellerUpdate(request.resource.data, resource.data)
          ) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.buyerCompanyId &&
           isValidBuyerUpdate(request.resource.data, resource.data)
          ) ||
          isSystemAdmin()
        );

      allow delete: if isSystemAdmin();
    }

    // =================================================================
    // Order Update Logic Functions (these are OK as they don't use get())
    // =================================================================

    function isAllowedSellerTransition(newStatus, oldStatus) {
        return (newStatus == 'Paid' && oldStatus == 'Agreed') ||
               (newStatus == 'Dispatched' && oldStatus == 'Paid') ||
               (newStatus == 'Cancelled' && (oldStatus == 'Draft' || oldStatus == 'Agreed'));
    }

    function isValidSellerUpdate(newData, oldData) {
      return isAllowedSellerTransition(newData.status, oldData.status) &&
             // Ensure critical fields are not mutated
             newData.buyerCompanyId == oldData.buyerCompanyId &&
             newData.sellerCompanyId == oldData.sellerCompanyId &&
             newData.currency == oldData.currency &&
             newData.lines == oldData.lines;
    }

     function isAllowedBuyerTransition(newStatus, oldData) {
        return (newStatus == 'Agreed' && oldData.status == 'Draft') ||
               (newStatus == 'Delivered' && oldData.status == 'Dispatched') ||
               (newStatus == 'Disputed' && oldData.status == 'Delivered' && oldData.paymentMethod == 'Escrow' && request.time < oldData.escrowDeadline);
    }

    function isValidBuyerUpdate(newData, oldData) {
      return isAllowedBuyerTransition(newStatus, oldData) &&
             // Ensure critical fields are not mutated
             newData.buyerCompanyId == oldData.buyerCompanyId &&
             newData.sellerCompanyId == oldData.sellerCompanyId &&
             newData.currency == oldData.currency &&
             newData.lines == oldData.lines;
    }
  }
}
