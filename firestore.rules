rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isUserApproved(userId) {
      let userData = getUserData(userId);
      // Safely check for the approval flag, default to false if missing
      return userData.get('companyIsApproved', false) == true;
    }

    function isAdmin() {
      // The admin UID must be in quotes.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // --- Rules ---

    // /users/{userId}
    match /users/{userId} {
      // READ: Allow a user to read their own data. Admin can read anyone's.
      allow read: if isUser(userId) || isAdmin();
      
      // CREATE: Allow any signed-in user to create their own user document.
      allow create: if isUser(userId);
      
      // UPDATE: Only allow a user to update their own document, or an admin to update anyone's.
      allow update: if isUser(userId) || isAdmin();
      
      // DELETE: Not allowed from client.
      allow delete: if false;
    }

    // /companies/{companyId}
    match /companies/{companyId} {
      // READ: Allow an approved user to read any company document. This is needed to populate contact/order details.
      // Unapproved users can read their own company document while awaiting approval.
      allow read: if isUserApproved(request.auth.uid) || 
                     (isUser(resource.data.ownerUid));

      // CREATE: Allow a signed-in user to create a company if they don't already have one.
      allow create: if isSignedIn() && getUserData(request.auth.uid).companyId == null;
      
      // UPDATE: Allow the company owner or an Admin to update.
      allow update: if isUser(resource.data.ownerUid) || isAdmin();
      
      // DELETE: Not allowed from client.
      allow delete: if false;
    }

    // /contacts/{contactId}
    match /contacts/{contactId} {
        // READ: Allow an approved user to read a specific contact document they are a member of.
        allow get: if isUserApproved(request.auth.uid) && request.auth.token.companyId in resource.data.members;

        // LIST: Allow an approved user to query for the contacts list.
        // The client-side query MUST include `where('members', 'array-contains', companyId)` for security.
        allow list: if isUserApproved(request.auth.uid);

        // CREATE, UPDATE, DELETE: Not allowed from client. Must be managed in the console.
        allow create, update, delete: if false;
    }
    
    // /orders/{orderId}
    match /orders/{orderId} {
      // READ: Allow an approved user to read a specific order they are a member of.
      allow get: if isUserApproved(request.auth.uid) && request.auth.token.companyId in resource.data.members;

      // LIST: Allow an approved user to query for the orders list.
      // The client-side query MUST include `where('members', 'array-contains', companyId)` for security.
      allow list: if isUserApproved(request.auth.uid);

      // CREATE, UPDATE: Allow an approved user who is a member of the order.
      allow create, update: if isUserApproved(request.auth.uid) && request.auth.token.companyId in request.resource.data.members;

      // DELETE: Not allowed from client.
      allow delete: if false;
    }
  }
}
