
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- UTILITY FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isApprovedUser() {
      let userData = getUserData(request.auth.uid);
      return userData.companyIsApproved == true;
    }

    // --- USERS ---
    match /users/{userId} {
      // Users can create their own user document on signup
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Users can only read/update their own data
      // This is also required for the rules functions to be able to read user data.
      allow read, update: if isSignedIn() && request.auth.uid == userId;
    }

    // --- COMPANIES ---
    match /companies/{companyId} {
      // An approved user or an admin can read any company profile.
      allow read: if isApprovedUser() || isSystemAdmin();

      // Only the System Admin can approve or modify companies.
      allow update: if isSystemAdmin();

      // A user can create a company for themselves, but it starts as 'Pending'.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'Pending';
    }

    // --- CONTACTS ---
    match /contacts/{contactId} {
      // Anyone who is a member of the contact can read it.
      allow read: if isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;

      // --- CREATE RULES ---
      // For creating an 'Unverified' contact, user only needs to be signed in.
      // For creating a 'Pending' contact (invite link), user must be approved.
      allow create: if isSignedIn() && 
                      (
                        (
                          request.resource.data.status == 'Unverified' &&
                          request.resource.data.companyAId == getUserData(request.auth.uid).companyId
                        ) ||
                        (
                          request.resource.data.status == 'Pending' &&
                          request.resource.data.companyAId == getUserData(request.auth.uid).companyId &&
                          isApprovedUser()
                        )
                      );


      // --- UPDATE RULES ---
      // Only for accepting an invite. The user must be approved.
      // Status must change from 'Pending' to 'Connected'.
      allow update: if isApprovedUser() &&
                      request.resource.data.companyBId == getUserData(request.auth.uid).companyId &&
                      resource.data.status == 'Pending' &&
                      request.resource.data.status == 'Connected';
    }

    // --- ORDERS ---
    match /orders/{orderId} {
        // Members of an order can read it.
        allow read: if isApprovedUser() && getUserData(request.auth.uid).companyId in resource.data.members;

        // An approved seller can create a draft order.
        allow create: if isApprovedUser() &&
                        request.resource.data.sellerCompanyId == getUserData(request.auth.uid).companyId &&
                        request.resource.data.status == 'Draft';

        // Complex update logic handled by a helper function.
        allow update: if isApprovedUser() && canUpdateOrder(request, resource);
    }

    function canUpdateOrder(request, resource) {
        let newStatus = request.resource.data.status;
        let oldStatus = resource.data.status;
        let userCompanyId = getUserData(request.auth.uid).companyId;
        let isBuyer = resource.data.buyerCompanyId == userCompanyId;
        let isSeller = resource.data.sellerCompanyId == userCompanyId;

        return (
            // Buyer can agree to a draft
            (isBuyer && oldStatus == 'Draft' && newStatus == 'Agreed') ||
            // Seller can mark as paid
            (isSeller && oldStatus == 'Agreed' && newStatus == 'Paid') ||
            // Seller can mark as dispatched
            (isSeller && oldStatus == 'Paid' && newStatus == 'Dispatched') ||
            // Buyer can mark as delivered
            (isBuyer && oldStatus == 'Dispatched' && newStatus == 'Delivered') ||
            // Buyer can dispute a delivered escrow order
            (isBuyer && oldStatus == 'Delivered' && resource.data.paymentMethod == 'Escrow' && newStatus == 'Disputed') ||
            // Seller can cancel a draft or agreed order
            (isSeller && (oldStatus == 'Draft' || oldStatus == 'Agreed') && newStatus == 'Cancelled')
        );
    }
  }
}
