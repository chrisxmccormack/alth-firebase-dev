
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAdmin() {
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isApprovedUser() {
      let userData = getUserData(request.auth.uid);
      if (userData.companyId == null) {
        return false;
      }
      let companyData = get(/databases/$(database)/documents/companies/$(userData.companyId)).data;
      return companyData.status == 'Approved';
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read, update: if isSignedIn() && isUser(userId);
      allow create: if isSignedIn() && isUser(userId);
    }

    // --- Company Profiles ---
    match /companies/{companyId} {
      // Any signed-in user can view company profiles.
      allow read: if isSignedIn();

      // Allow company creation in two scenarios:
      // 1. A new user creating their own company profile.
      // 2. An approved user creating an ownerless company for a direct contact.
      allow create: if isSignedIn() && (
        (request.resource.data.ownerUid == request.auth.uid && getUserData(request.auth.uid).companyId == null) ||
        (isApprovedUser() && request.resource.data.ownerUid == null)
      );

      // An admin can update anything.
      // An owner can update their own company, but cannot change their status or ownership.
      allow update: if isAdmin() || (
        isApprovedUser() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.ownerUid == resource.data.ownerUid
      );
    }

    // --- Contact Relationships ---
    match /contacts/{contactId} {
      // You can read a contact document if your company is a member.
      allow read: if isApprovedUser() && getUserData(request.auth.uid).companyId in resource.data.members;

      // You can create a contact if you are an approved user and the data is valid for the scenario.
      allow create: if isApprovedUser() && request.resource.data.companyAId == getUserData(request.auth.uid).companyId;

      // You can update a contact only to accept an invite.
      allow update: if isApprovedUser() &&
                       resource.data.status == 'Pending' &&
                       request.resource.data.status == 'Connected' &&
                       request.resource.data.companyBId == getUserData(request.auth.uid).companyId &&
                       request.resource.data.companyAId == resource.data.companyAId;
    }

    // --- Orders ---
    match /orders/{orderId} {
      // You can read/update an order if your company is a member.
      allow read, update: if isApprovedUser() && getUserData(request.auth.uid).companyId in resource.data.members;

      // You can create an order if you are the seller.
      allow create: if isApprovedUser() &&
                       request.resource.data.sellerCompanyId == getUserData(request.auth.uid).companyId &&
                       request.resource.data.status == 'Draft';
    }
  }
}
