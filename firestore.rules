rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSystemAdmin(userId) {
      // The admin UID must be in single quotes.
      return userId == 'YOUR_ADMIN_UID_HERE';
    }

    // A user can read and write to their own user document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Company rules
    match /companies/{companyId} {
      // Any authenticated user can see the details of any *approved* company.
      // This is necessary to show contact names, etc.
      allow read: if request.auth != null && (
        resource.data.status == 'Approved' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );

      // An authenticated user can create a company.
      allow create: if request.auth != null;

      // Only the system admin can update a company (i.e., to approve it).
      allow update: if request.auth != null && isSystemAdmin(request.auth.uid);
    }

    // Contact rules
    match /contacts/{contactId} {
      // To create a contact, the user must be authenticated,
      // and the companyAId in the new document must match the companyId
      // stored in that user's own document in the /users collection.
      allow create: if request.auth != null &&
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == request.resource.data.companyAId;

      // To read or update a contact, the user's company must be
      // either companyA or companyB in the contact document.
      allow read, update: if request.auth != null &&
                           exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.companyAId ||
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == resource.data.companyBId);
    }
  }
}
