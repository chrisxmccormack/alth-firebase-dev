rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============== Helper Functions ==============
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }
    
    // IMPORTANT: Replace UID during deployment!
    function isSystemAdmin() {
      return uid() == 'YOUR_ADMIN_UID_HERE'; 
    }

    // Retrieves the user's document data from the /users collection
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    
    // Gets the companyId associated with the current user
    function myCompanyId() {
      return getUserDoc().companyId;
    }
    
    // Checks if the user is the owner of a specific company
    function isOwner(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == uid();
    }
    
    // Checks if a company is approved
    function isCompanyApproved(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'Approved';
    }

    // ============== User Profiles ==============
    match /users/{userId} {
      allow read, write: if isAuth() && userId == uid();
    }

    // ============== Company Profiles ==============
    match /companies/{companyId} {
      // Read: Any authenticated user with an approved company, or admin.
      allow read: if isSystemAdmin() || (isAuth() && isCompanyApproved(myCompanyId()));
      
      // Create: Any authenticated user without a company yet.
      allow create: if isAuth() && myCompanyId() == null;
      
      // Update: The owner of the company, or the system admin.
      allow update: if isAuth() && (isOwner(companyId) || isSystemAdmin());
    }
    
    // ============== Contacts ==============
    match /contacts/{contactId} {
      let doc = resource.data;
      let requestDoc = request.resource.data;

      // Read: Can read a contact if your company is a member.
      // This works for both GET and LIST (with array-contains query).
      allow read: if isAuth() && myCompanyId() in doc.members;
      
      // Create: Can create invites/contacts for your own approved company.
      allow create: if isAuth() && 
                     isCompanyApproved(myCompanyId()) &&
                     requestDoc.companyAId == myCompanyId() &&
                     myCompanyId() in requestDoc.members;

      // Update: Only to accept a pending invite.
      allow update: if isAuth() &&
                     isCompanyApproved(myCompanyId()) &&
                     doc.status == 'Pending' &&
                     requestDoc.status == 'Connected' &&
                     requestDoc.companyBId == myCompanyId() &&
                     myCompanyId() in requestDoc.members;
    }
    
    // ============== Orders ==============
    match /orders/{orderId} {
      let doc = resource.data;
      let requestDoc = request.resource.data;

      // Read: Can read an order if your company is a member.
      // This works for both GET and LIST (with array-contains query).
      allow read: if isAuth() && myCompanyId() in doc.members;
      
      // Create: Only sellers from an approved company can create orders.
      allow create: if isAuth() && 
                       isCompanyApproved(myCompanyId()) &&
                       requestDoc.sellerCompanyId == myCompanyId() &&
                       myCompanyId() in requestDoc.members;
                       
      // Update: Logic is delegated to helper functions.
      allow update: if isAuth() && isCompanyApproved(myCompanyId()) &&
                     ( (doc.sellerCompanyId == myCompanyId() && validSellerUpdate(doc, requestDoc)) ||
                       (doc.buyerCompanyId == myCompanyId()  && validBuyerUpdate(doc, requestDoc))  ||
                       isSystemAdmin() );
    }

    // Helper for validating seller-initiated status changes
    function validSellerUpdate(doc, requestDoc) {
      return (doc.status == 'Agreed' && requestDoc.status == 'Paid') ||
             (doc.status == 'Paid' && requestDoc.status == 'Dispatched') ||
             (doc.status in ['Draft', 'Agreed'] && requestDoc.status == 'Cancelled');
    }
    
    // Helper for validating buyer-initiated status changes
    function validBuyerUpdate(doc, requestDoc) {
      return (doc.status == 'Draft' && requestDoc.status == 'Agreed') ||
             (doc.status == 'Dispatched' && requestDoc.status == 'Delivered') ||
             (doc.status == 'Delivered' && requestDoc.status in ['Disputed', 'InQuery']);
    }
  }
}
