
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // IMPORTANT: Replace with your actual Firebase UID for the system admin.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Get the user's data from the /users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if the currently signed-in user's company is approved.
    // This is the main check for most operations.
    function isApprovedUser() {
      let companyId = getUserData().companyId;
      if (companyId == null) {
        return false;
      }
      let companyStatus = get(/databases/$(database)/documents/companies/$(companyId)).data.status;
      return isSignedIn() && companyStatus == 'Approved';
    }

    // --- RULES ---

    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      // Allow a user to be created when they sign up.
      allow create: if isSignedIn();
    }

    match /companies/{companyId} {
      // Allow any signed-in user to read company data. This is needed to display partner info.
      allow read: if isSignedIn();

      // Only the system admin or the company's owner can update a company document.
      allow update: if isSystemAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // A user can create a company if:
      // 1. They are creating their own company during setup (ownerUid matches their uid).
      // 2. They are an approved user creating a company for a direct contact (ownerUid is null).
      allow create: if (isSignedIn() && request.resource.data.ownerUid == request.auth.uid)
                    || (isApprovedUser() && request.resource.data.ownerUid == null);
    }

    match /contacts/{contactId} {
      // Allow read if the user's company is in the contact's 'members' array.
      allow read: if isApprovedUser() && resource.data.members.hasAny([getUserData().companyId]);

      // Allow creating a contact if the user is approved.
      // This rule works for both creating an invite link and direct creation.
      allow create: if isApprovedUser() && request.resource.data.members.hasAny([getUserData().companyId]);

      // Allow updating a contact (i.e., accepting an invite) if the user is approved,
      // and their company is being added as companyBId.
      allow update: if isApprovedUser()
                    && request.resource.data.companyBId == getUserData().companyId
                    && resource.data.companyBId == null;
    }

    match /orders/{orderId} {
      // Allow read if the user's company is in the order's 'members' array.
      allow read: if isApprovedUser() && resource.data.members.hasAny([getUserData().companyId]);
      
      // Allow create if the user is approved and is the seller.
      allow create: if isApprovedUser() && request.resource.data.sellerCompanyId == getUserData().companyId;
      
      // Allow update if the user's company is in the order's 'members' array.
      allow update: if isApprovedUser() && resource.data.members.hasAny([getUserData().companyId]);
    }
  }
}
