
rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      // Use the get() function on an environment variable for security
      // Note: You must set this in your functions/backend environment
      // This placeholder is for local testing with the emulator.
      // return request.auth.uid == get(/databases/$(db)/documents/config/admin).data.uid;
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    function getUserDoc(uid) {
      return get(/databases/$(db)/documents/users/$(uid));
    }

    function hasCompany(uid) {
      return getUserDoc(uid).data.companyId != null;
    }
    
    function getCompanyId(uid) {
      return getUserDoc(uid).data.companyId;
    }

    // --- User Rules ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSystemAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Company Rules ---
    function isCreatingOwnCompany() {
      // Allows a new user (without a companyId yet) to create a company for themselves.
      return isSignedIn() &&
             request.resource.data.ownerUid == request.auth.uid &&
             hasCompany(request.auth.uid) == false;
    }

    function isCreatingContactCompany() {
      // Allows a user who *already has* a company to create a new "stub" company for a contact.
      return isSignedIn() &&
             hasCompany(request.auth.uid) == true &&
             request.resource.data.ownerUid == null;
    }

    function isOwnerOfCompany(companyId) {
      let companyDoc = get(/databases/$(db)/documents/companies/$(companyId));
      return isSignedIn() && companyDoc.data.ownerUid == request.auth.uid;
    }
    
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isCreatingOwnCompany() || isCreatingContactCompany();
      allow update: if isOwnerOfCompany(companyId) || isSystemAdmin();
    }

    // --- Contact Rules ---
    function isCreatingValidInvite() {
      let requestData = request.resource.data;
      return isSignedIn() &&
             requestData.status == 'Pending' &&
             requestData.companyAId == getCompanyId(request.auth.uid) &&
             requestData.companyBId == null;
    }

    function isCreatingValidDirectContact() {
        let requestData = request.resource.data;
        return isSignedIn() &&
            requestData.status == 'Connected' &&
            requestData.companyAId == getCompanyId(request.auth.uid) &&
            requestData.companyBId != null;
    }

    function isAcceptingInvite(contactId) {
        let existingContact = get(/databases/$(db)/documents/contacts/$(contactId)).data;
        let incomingData = request.resource.data;
        let myCompanyId = getCompanyId(request.auth.uid);

        return isSignedIn() &&
            hasCompany(request.auth.uid) &&
            existingContact.status == 'Pending' &&
            incomingData.status == 'Connected' &&
            incomingData.companyBId == myCompanyId &&
            existingContact.companyAId != myCompanyId; // Can't accept own invite
    }

    match /contacts/{contactId} {
      allow read: if isSignedIn() && getCompanyId(request.auth.uid) in resource.data.members;
      allow create: if isCreatingValidInvite() || isCreatingValidDirectContact();
      allow update: if isAcceptingInvite(contactId);
    }

    // --- Order Rules ---
    function isPartyToOrder() {
      return isSignedIn() && getCompanyId(request.auth.uid) in resource.data.members;
    }

    function isValidOrderCreation() {
      let data = request.resource.data;
      let sellerCompanyId = getCompanyId(request.auth.uid);

      return isSignedIn() &&
             hasCompany(request.auth.uid) &&
             data.sellerCompanyId == sellerCompanyId &&
             sellerCompanyId in data.members &&
             data.buyerCompanyId in data.members;
    }
    
    function isValidOrderUpdate(existingOrder) {
        let incomingData = request.resource.data;
        let myCompanyId = getCompanyId(request.auth.uid);
        let isSeller = myCompanyId == existingOrder.sellerCompanyId;
        let isBuyer = myCompanyId == existingOrder.buyerCompanyId;

        let validSellerTransitions = {
            "Draft": ["Agreed", "Cancelled"],
            "Agreed": ["Paid", "Cancelled"], // "Paid" is manual for now but rule allows it
            "Paid": ["Dispatched"],
            "Delivered": ["Completed"] // Auto-completed by function but rule allows manual
        };

        let validBuyerTransitions = {
            "Draft": ["Agreed"],
            "Dispatched": ["Delivered"],
            "Delivered": ["Disputed", "InQuery"]
        };

        let currentStatus = existingOrder.status;
        let nextStatus = incomingData.status;

        // Allow status update if it's a valid transition for the user's role
        if (currentStatus != nextStatus) {
            if (isSeller && nextStatus in validSellerTransitions[currentStatus]) {
                return true;
            }
            if (isBuyer && nextStatus in validBuyerTransitions[currentStatus]) {
                return true;
            }
            return false; // Invalid status transition
        }
        
        // Allow other field updates if status isn't changing (e.g., adding trackingId)
        if (isSeller && currentStatus != 'Cancelled' && currentStatus != 'Completed') {
            return true;
        }

        return false;
    }

    match /orders/{orderId} {
      allow read: if isPartyToOrder() || isSystemAdmin();
      allow create: if isValidOrderCreation();
      allow update: if isPartyToOrder() && isValidOrderUpdate(resource.data);
    }
  }
}
