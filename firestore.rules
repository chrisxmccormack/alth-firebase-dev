
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Pass the admin UID string directly into this function
    function isUserAdmin(adminUid) {
      return isUserAuthenticated() && request.auth.uid == adminUid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedUser() {
      let userData = getUserData();
      let companyId = userData.companyId;
      // User must have a companyId to be considered approved for actions
      if (companyId == null) {
        return false;
      }
      let companyStatus = get(/databases/$(database)/documents/companies/$(companyId)).data.status;
      return companyStatus == 'Approved';
    }

    // --- User Profiles ---
    match /users/{userId} {
      // Users can only create their own profile
      allow create: if isUserAuthenticated() && request.auth.uid == userId;
      // Users can only read and update their own profile
      allow read, update: if isUserAuthenticated() && request.auth.uid == userId;
    }

    // --- Companies ---
    match /companies/{companyId} {
      // Admins can do anything
      allow read, write: if isUserAdmin('YOUR_ADMIN_UID_HERE');

      // Allow creation under two conditions:
      // 1. A new user is creating their own company profile.
      // 2. An approved existing user is creating an ownerless company (for a new contact).
      allow create: if (isUserAuthenticated() && request.resource.data.ownerUid == request.auth.uid) || 
                       (isApprovedUser() && request.resource.data.ownerUid == null);

      // Only approved users can view company data
      allow read: if isApprovedUser();
    }
    
    // --- Contacts ---
    match /contacts/{contactId} {
        // Admins can do anything
        allow read, write: if isUserAdmin('YOUR_ADMIN_UID_HERE');
        
        // Allow creation if the user is an approved member of their own company.
        // We check the incoming data, not a pre-existing document.
        allow create: if isApprovedUser() && request.resource.data.companyAId == getUserData().companyId;
        
        // Allow read/update if the user is a member of the contact link.
        allow read, update: if isApprovedUser() && getUserData().companyId in resource.data.members;
    }

    // --- Orders ---
    match /orders/{orderId} {
        // Admins can do anything
        allow read, write: if isUserAdmin('YOUR_ADMIN_UID_HERE');

        // Allow creation if the user is an approved member of the seller company.
        allow create: if isApprovedUser() && request.resource.data.sellerCompanyId == getUserData().companyId;
        
        // Allow read/update if the user's company is a member of the order.
        allow read, update: if isApprovedUser() && getUserData().companyId in resource.data.members;
    }
  }
}
