
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAdmin() {
      // The admin UID must be in single quotes.
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // A robust function to check if the current user is associated with an approved company.
    function isApprovedUser() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // This is the key fix:
      // 1. It checks if the user document exists.
      // 2. It uses .get('field', false) to safely access the approval flag,
      //    defaulting to 'false' if the field doesn't exist. This prevents errors
      //    for older user accounts or race conditions.
      return exists(userPath) && get(userPath).data.get('companyIsApproved', false) == true;
    }

    // A function to check if the user is a member of a given contact or order.
    function isMember() {
      // Get the user's companyId from their own user document.
      let userCompanyId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
      // Check if that companyId is in the 'members' array of the document being accessed.
      return userCompanyId in resource.data.members;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Users can read and update their own data.
      // Users can create their own user document during registration.
      allow read, update, create: if request.auth.uid == userId;
    }

    match /companies/{companyId} {
      // Admins can read/update any company.
      // The owner can read their own company document.
      allow read: if isAdmin() || request.auth.uid == resource.data.ownerUid;
      // Only Admins can update companies (for approval).
      allow update: if isAdmin();
      // Any signed-in user can create a company profile (it starts as 'Pending').
      allow create: if request.auth != null &&
                       request.resource.data.status == 'Pending' &&
                       request.resource.data.ownerUid == request.auth.uid;
    }

    match /contacts/{contactId} {
      // An approved user can read contacts they are a member of.
      allow read: if isApprovedUser() && isMember();

      // An approved user can update contacts they are a member of.
      allow update: if isApprovedUser() && isMember();

      allow create: if
        // Case 1: Creating an invite link ('Pending' status) requires user to be approved.
        (isApprovedUser() && request.resource.data.status == 'Pending') ||
        // Case 2: Creating a direct contact ('Unverified' status) requires user to be signed in and own the doc.
        (request.auth != null && request.resource.data.status == 'Unverified' && request.resource.data.ownerUid == request.auth.uid);
    }

    match /orders/{orderId} {
      // An approved user can read/update orders they are a member of.
      allow read, update: if isApprovedUser() && isMember();
      // An approved user can create orders.
      allow create: if isApprovedUser();
    }
  }
}
