rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // By defining the user document retrieval once, we make the rules more efficient
    // and prevent repeated 'get' calls for the same data within a single evaluation.
    let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));

    // =================================
    // Helper Functions
    // =================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isSignedIn() && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Checks if the user is approved by safely checking the passed-in user document.
    function isApprovedUser(doc) {
      return isSignedIn()
             && doc != null
             && doc.data.get('companyIsApproved', false) == true;
    }

    // Safely gets the company ID from the passed-in user document.
    function getUserCompanyId(doc) {
      if (doc != null) {
        return doc.data.get('companyId', null);
      }
      return null;
    }

    // Checks if the current user is the owner of a given document.
    function isOwner(docData) {
      return isSignedIn() && request.auth.uid == docData.get('ownerUid', null);
    }
    
    // =================================
    // Collection Rules
    // =================================

    // USERS: Governs access to user data.
    match /users/{userId} {
      // A user can create, read, and update their own document.
      allow read, update, create: if isSignedIn() && request.auth.uid == userId;
    }

    // COMPANIES: Governs access to company profiles.
    match /companies/{companyId} {
      // Any approved user or admin can read any company profile.
      // A pending user must be able to read their own company to check its status.
      allow read: if isApprovedUser(userDoc) 
                  || isSystemAdmin() 
                  || (isSignedIn() && getUserCompanyId(userDoc) == companyId);

      // Only authenticated users can create a company profile for themselves.
      allow create: if isSignedIn() && isOwner(request.resource.data);
      
      // Only the approved owner or an admin can update a company.
      allow update: if (isApprovedUser(userDoc) && isOwner(resource.data)) || isSystemAdmin();
    }

    // CONTACTS: Governs connections between companies.
    match /contacts/{contactId} {
      // A user can get a contact if their company is a member.
      allow get: if isApprovedUser(userDoc) && getUserCompanyId(userDoc) in resource.data.members;

      // An approved user can list contacts. The client-side query ensures they only see their own.
      allow list: if isApprovedUser(userDoc);
      
      // Creating an 'Unverified' contact is allowed for any signed-in user.
      // Creating a 'Pending' (invite) contact requires the user to be approved.
      allow create: if (request.resource.data.status == 'Unverified' && isSignedIn() && request.resource.data.ownerUid == request.auth.uid) 
                   || (request.resource.data.status == 'Pending' && isApprovedUser(userDoc) && getUserCompanyId(userDoc) == request.resource.data.companyAId);

      // An approved user can accept an invite, which updates the contact.
      allow update: if isApprovedUser(userDoc)
                      && request.resource.data.status == 'Connected'
                      && resource.data.status == 'Pending'
                      && getUserCompanyId(userDoc) == request.resource.data.companyBId
                      && request.resource.data.companyBId != resource.data.companyBId;
    }

    // ORDERS: Governs sales and purchase orders.
    match /orders/{orderId} {
      // An approved user can get an order if their company is a member.
      allow get: if isApprovedUser(userDoc) && getUserCompanyId(userDoc) in resource.data.members;

      // An approved user can list orders. The client-side query ensures they only see their own.
      allow list: if isApprovedUser(userDoc);

      // An approved user can create an order where they are the seller.
      allow create: if isApprovedUser(userDoc) && getUserCompanyId(userDoc) == request.resource.data.sellerCompanyId;
      
      // An approved user who is a member of the order can update it.
      allow update: if isApprovedUser(userDoc) && getUserCompanyId(userDoc) in resource.data.members;
    }
  }
}
