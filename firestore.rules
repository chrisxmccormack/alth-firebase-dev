rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSystemAdmin() {
      // CRITICAL: Replace with your actual Admin UID, KEEP THE QUOTES
      return request.auth.uid == 'zcL2mAF06kcAPb68DMIfLmkYROE3'; 
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function getCompany(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }
    
    function isCompanyOwner(companyId) {
      return getCompany(companyId).data.ownerUid == request.auth.uid;
    }
    
    function isUserCompanyApproved() {
        let userData = getUserData(request.auth.uid);
        // This function checks if the currently authenticated user belongs to an approved company.
        return isSignedIn() && userData.companyId != null && getCompany(userData.companyId).data.status == 'Approved';
    }
    
    // --- Rules ---

    match /users/{userId} {
      allow read, update: if isUser(userId) || isSystemAdmin();
      allow create: if isUser(userId);
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();

      // To create a company, you must either:
      // 1. Be the user who is being assigned as the owner (initial company setup).
      // 2. Be an already-approved user creating an ownerless company (for a direct contact).
      allow create: if (isUser(request.resource.data.ownerUid)) || 
                       (isUserCompanyApproved() && request.resource.data.ownerUid == null);

      allow update: if isCompanyOwner(companyId) || isSystemAdmin();
    }

  match /contacts/{id} {
  allow create: if isSignedIn();         // TEMP for debugging
  allow read, update, delete: if isSignedIn();
}

    match /orders/{orderId} {
      allow read: if isSignedIn() && getUserData(request.auth.uid).companyId in resource.data.members;
      
      allow create: if 
          isUserCompanyApproved() && 
          request.resource.data.sellerCompanyId == getUserData(request.auth.uid).companyId;

      allow update: if isUserCompanyApproved();
    }
  }
}
